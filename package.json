{
  "name": "atlas-portal",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive historical atlas portal - a gallery of cartographic visual essays.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run registries:validate && npm run editorial:validate && npm run typography:validate && npm run epic:validate && npm run release:validate && npm run hanseatic:validate && npm run hanseatic:release:validate && npm run dacia:validate && npm run crusades:validate && npm run antarctica:validate && npm run provenance:write && astro build && npm run reports:check && npm run embed:prune && npm run indexing:validate && npm run geo:interop:validate && npm run handbook:validate",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:vmn-visual": "playwright test e2e/vmn-visual.spec.ts --project=chromium",
    "registries:validate": "node scripts/validate-registries.mjs",
    "editorial:validate": "node scripts/validate-editorial.mjs",
    "typography:validate": "node scripts/validate-typography.mjs",
    "epic:validate": "node scripts/validate-epic-evidence.mjs",
    "release:validate": "node scripts/validate-next-55.mjs",
    "analytics:validate": "node scripts/validate-analytics.mjs",
    "reports:write": "astro build && node scripts/generate-publication-reports.mjs --write",
    "reports:check": "node scripts/generate-publication-reports.mjs --check",
    "indexing:validate": "node scripts/validate-indexing.mjs",
    "geo:interop:validate": "node scripts/validate-geo-interop.mjs",
    "lighthouse": "node scripts/lighthouse.mjs",
    "geo:validate": "node scripts/geo-release.mjs --check",
    "geo:manifest": "node scripts/geo-release.mjs --write",
    "hanseatic:build": "make hanseatic",
    "hanseatic:validate": "python3 scripts/hanseatic/validate.py",
    "hanseatic:release:validate": "node scripts/validate-hanseatic-release.mjs",
    "hanseatic:test": "python3 -m pytest scripts/hanseatic -q",
    "dacia:validate": "python3 scripts/dacia/validate.py",
    "dacia:test": "python3 -m pytest scripts/dacia -q",
    "crusades:validate": "python3 scripts/crusades/validate.py",
    "crusades:test": "python3 -m pytest scripts/crusades -q",
    "antarctica:build": "make antarctica",
    "antarctica:validate": "python3 scripts/antarctica/validate.py",
    "antarctica:test": "python3 -m pytest scripts/antarctica -q",
    "provenance:write": "node scripts/generate-build-info.mjs",
    "production:verify": "node scripts/verify-production.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "create-essay": "node scripts/create-essay.mjs",
    "essay:release": "node scripts/release-essay.mjs",
    "embed:prune": "node scripts/prune-held-embeds.mjs",
    "build-geo-layer": "node scripts/build-geo-layer.mjs",
    "build-og-images": "node scripts/build-og-images.mjs",
    "build-room-images": "node scripts/build-room-images.mjs",
    "cartometry:export": "node scripts/export-cartometry.mjs",
    "build-map-tiles": "node scripts/build-map-tiles.mjs",
    "astro": "astro",
    "handbook:validate": "node scripts/validate-handbook.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^5.3.0",
    "@astrojs/mdx": "^3.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "3.2.1",
    "@astrojs/tailwind": "^5.1.4",
    "@fontsource-variable/cinzel": "^5.2.8",
    "@fontsource-variable/crimson-pro": "^5.2.8",
    "@fontsource-variable/eb-garamond": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "astro": "^4.16.18",
    "flatgeobuf": "^4.4.0",
    "fuse.js": "^7.5.0",
    "github-slugger": "^2.0.0",
    "maplibre-gl": "^4.7.1",
    "openseadragon": "^4.1.1",
    "pmtiles": "^3.2.1",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.61.1",
    "@types/openseadragon": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.33.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  }
}
