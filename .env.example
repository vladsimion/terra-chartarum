# Analytics is disabled unless all three variables are set at build time.
# Copy the exact site-specific pa-*.js URL from Plausible Site Installation.
PUBLIC_ANALYTICS_PROVIDER=plausible
PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/pa-XXXXX.js
PUBLIC_PLAUSIBLE_DOMAIN=terra-chartarum.pages.dev

# Local authoring only - never set this in Cloudflare Pages. Pass it on the
# command line (SHOW_UNRELEASED=1 npm run dev) to render essays that the staged
# release gate is still holding back. Read from process.env, not a .env file.
# SHOW_UNRELEASED=1
