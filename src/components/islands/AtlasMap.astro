---
/**
 * AtlasMap (ATLAS-502 / ATLAS-EG3)
 *
 * Cross-essay map view: MapLibre GL base map with a pin per corpus map, popups
 * deep-linking to the source essay, a chronological time-slider, and faceted
 * search. Registered GeoLayers (ATLAS-EG2) render as live vector overlays via the
 * MapLibre pipeline (ATLAS-EG3): GeoJSON sources load now; the PMTiles protocol is
 * registered so a `.pmtiles` layer goes live the moment its asset is present. The
 * time-slider filters both corpus pins and geo layers by temporal extent. Degrades
 * to a grouped list where WebGL is unavailable.
 */
import { existsSync, readFileSync } from 'node:fs';
import { join } from 'node:path';
import 'maplibre-gl/dist/maplibre-gl.css';
import { getCorpusCore, corpusYearRange } from '../../lib/corpus';
import { getGeoLayers } from '../../lib/geo';
import { versionedGeoUrl } from '../../lib/geo-release';
import { coveragePolygons } from '../../lib/coverage';
import { getToponyms, toponymAuthorityLinks, toponymNames } from '../../lib/toponyms';
import { getEssays, formatYear } from '../../lib/registry';
import { getVmnAtlasLinks } from '../../lib/vmn-atlas-links';
import { auditCatalogueAvailability, projectCatalogue } from '../../lib/atlas-catalogue';
import { loadHandbook } from '../../lib/handbook-content';
import AtlasLayerBrowser from './AtlasLayerBrowser.astro';
import AtlasActiveLayers from './AtlasActiveLayers.astro';

// Only the atlas-critical projection ships to the client - rich catalogue
// metadata (provenance, bibliography, imagery) stays server-side (KAN-66).
const corpus = getCorpusCore();
const layers = getGeoLayers();
const essays = await getEssays();
const [minYear, maxYear] = corpusYearRange();

// Depicted-extent footprints (KAN-74): each map's coverage ring plus its title,
// in corpus (chronological) order, for the atlas "depicted within" filter.
const corpusTitle = new Map(corpus.map((m) => [m.id, m.title] as const));
const coverage = coveragePolygons()
  .filter((c) => corpusTitle.has(c.mapId))
  .map((c) => ({ id: c.mapId, title: corpusTitle.get(c.mapId)!, ring: c.ring }))
  .sort((a, b) => corpus.findIndex((m) => m.id === a.id) - corpus.findIndex((m) => m.id === b.id));

const essayMeta = Object.fromEntries(
  essays.map((e) => [
    e.slug,
    {
      title: e.data.title,
      summary: e.data.summary,
      accent: e.data.accent ?? '#d4b87a',
      yearFrom: e.data.yearFrom,
      yearTo: e.data.yearTo,
      room: e.data.room,
    },
  ]),
);

// Staged release (KAN-263): `essays` holds only released essays, so essayMeta
// is also the released set. The corpus, the GIS layers and the toponym
// concordance are authored independently of the release schedule, so anything
// they say about a held essay - its route, its title - has to be withheld too.
// A corpus map falls back to its own catalogue page, which always exists.
const isEssayReleased = (slug: string) => Boolean(essayMeta[slug]);

// A layer is toggleable only when its asset is actually on disk under /public.
const publicDir = join(process.cwd(), 'public');
const layerMeta = layers.map((l) => ({
  ...l,
  essayLinks: l.essayLinks.filter((link) => isEssayReleased(link.slug)),
  available: existsSync(join(publicDir, l.url.replace(/^\//, ''))),
}));

// The scalable catalogue (KAN-399), and the release gate that replaces the old
// `pending` row (KAN-404).
//
// Editorial lifecycle and runtime availability are separate facts. A layer whose
// scholarship is published or under review and whose asset is absent is a
// release defect, and the build says so by name instead of shipping a disabled
// checkbox that quietly means "we never finished this". Planned and
// in-preparation layers may legitimately have no binary; the projection keeps
// them out of the live browser entirely rather than listing them as broken.
const catalogue = projectCatalogue({
  availableLayerIds: layerMeta.filter((l) => l.available).map((l) => l.id),
  releasedEssaySlugs: Object.keys(essayMeta),
  documentationRoutes: (await loadHandbook()).routes,
});
const availabilityDefects = auditCatalogueAvailability(catalogue);
if (availabilityDefects.length > 0) {
  throw new Error(
    `Atlas release gate failed:\n  ${availabilityDefects.join('\n  ')}\n` +
      'Compile the asset, or move the layer to lifecycle in-preparation.',
  );
}
const documentationRoutes = (await loadHandbook()).routes;
// Facets and documentation now belong to the inspector (KAN-402), so the
// browser needs only the layers it will actually list.
const browsable = layerMeta.filter((l) => catalogue.layers.some((row) => row.id === l.id));

// Facet options (KAN-340). A layer declares which properties are filterable; the
// values are read out of the committed GeoJSON here, at build time, so the panel
// needs no client fetch and a new corpus layer arrives with its own facets
// instead of requiring a change to this island.
const readableTerm = (value: string) =>
  value.replace(/_/g, ' ').replace(/^./, (c) => c.toUpperCase());
const FACET_LABELS: Record<string, string> = {
  attestation_class: 'What the source does',
  confidence: 'Confidence',
  source_id: 'Source',
  source_family: 'Kind of source',
  language: 'Language',
  script: 'Script',
  review_state: 'Review state',
};
// Where a facet's raw value is an identifier, the readable label lives on a
// companion property of the same feature.
const FACET_LABEL_FROM: Record<string, string> = {
  source_id: 'source_title',
  language: 'language_label',
  script: 'script_label',
  attestation_class: 'attestation_class_label',
  confidence: 'confidence_label',
};

type FacetValue = { value: string; label: string; count: number };
type Facet = { field: string; label: string; values: FacetValue[] };

const layerFacets: Record<string, Facet[]> = Object.fromEntries(
  layerMeta
    .filter((l) => l.facets.length > 0 && l.available && l.format === 'geojson')
    .map((l) => {
      let features: { properties?: Record<string, unknown> }[] = [];
      try {
        const raw = readFileSync(join(publicDir, l.url.replace(/^\//, '')), 'utf8');
        features = (JSON.parse(raw) as { features?: typeof features }).features ?? [];
      } catch {
        features = []; // asset unreadable - the layer simply offers no facets
      }
      const facets = l.facets
        .map((field) => {
          const counts = new Map<string, number>();
          const labels = new Map<string, string>();
          for (const feature of features) {
            const value = String(feature.properties?.[field] ?? '').trim();
            if (!value) continue;
            counts.set(value, (counts.get(value) ?? 0) + 1);
            const from = FACET_LABEL_FROM[field];
            const label = from ? String(feature.properties?.[from] ?? '').trim() : '';
            if (label) labels.set(value, label);
          }
          return {
            field,
            label: FACET_LABELS[field] ?? readableTerm(field),
            values: [...counts.entries()]
              .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
              .map(([value, count]) => ({
                value,
                label: labels.get(value) ?? readableTerm(value),
                count,
              })),
          };
        })
        // A facet with a single value cannot narrow anything, so offering it
        // would be a control that does nothing.
        .filter((facet) => facet.values.length > 1);
      return [l.id, facets] as const;
    })
    .filter(([, facets]) => facets.length > 0),
);

// Toponym concordance (KAN-75): a separate, toggleable pin set of places carrying
// the ancient / medieval / variant names by which the corpus calls them, with the
// essays and maps that reference each - resolved here so the popup is self-contained.
const toponyms = getToponyms().map((t) => ({
  id: t.id,
  modern: t.modern,
  names: toponymNames(t),
  historical: toponymNames(t).slice(1),
  coords: t.coords,
  authorityLinks: toponymAuthorityLinks(t),
  linkedPlacesUrl: `/geo/toponyms.lpf.json#${encodeURIComponent(t.id)}`,
  essays: t.essaySlugs
    .filter((s) => isEssayReleased(s))
    .map((s) => ({ slug: s, title: essayMeta[s]!.title })),
  maps: t.mapIds
    .filter((id) => corpusTitle.has(id))
    .map((id) => ({ id, title: corpusTitle.get(id)! })),
}));

const payload = {
  corpus: corpus.map((m) => ({
    ...m,
    accent: essayMeta[m.essaySlug]?.accent ?? '#d4b87a',
    // Held source essay: name and link the map's catalogue entry instead.
    essayHref: isEssayReleased(m.essaySlug) ? `/essays/${m.essaySlug}/` : `/collection/${m.id}/`,
    essayTitle: essayMeta[m.essaySlug]?.title ?? m.title,
    essaySummary: essayMeta[m.essaySlug]?.summary ?? '',
    essayYearFrom: essayMeta[m.essaySlug]?.yearFrom ?? m.year,
    essayYearTo: essayMeta[m.essaySlug]?.yearTo ?? m.year,
    yearLabel: formatYear(m.year),
  })),
  essays: essays.map((essay) => ({
    slug: essay.slug,
    title: essay.data.title,
    summary: essay.data.summary,
    yearFrom: essay.data.yearFrom,
    yearTo: essay.data.yearTo,
    room: essay.data.room,
  })),
  layers: layerMeta.map((l) => ({
    id: l.id,
    url: versionedGeoUrl(l),
    format: l.format,
    geometry: l.geometry,
    color: l.color,
    yearFrom: l.yearFrom,
    yearTo: l.yearTo,
    sourceLayer: l.sourceLayer ?? null,
    perFeatureTime: l.perFeatureTime,
    graduate: l.graduate ?? null,
    dash: l.dash ?? null,
    width: l.width ?? null,
    documentationLinks: l.documentationLinks,
    essayLinks: l.essayLinks.map((link) => ({
      href: `/essays/${link.slug}/#${link.sectionId}`,
      label: link.label,
    })),
    available: l.available,
    defaultOn: l.defaultOn && l.available,
    facets: layerFacets[l.id] ?? [],
  })),
  vmnLinks: getVmnAtlasLinks().map(({ beatId, targetType, targetId, year, layerIds }) => ({
    beatId,
    targetType,
    targetId,
    year,
    layerIds,
  })),
  coverage,
  toponyms,
  minYear,
  maxYear,
};
---

<section class="atlasmap" data-atlasmap>
  <div class="controls">
    <input
      type="search"
      class="am-search"
      placeholder="Search maps, regions, essays…"
      aria-label="Search the corpus"
    />
    <select class="am-essay" aria-label="Filter by essay">
      <option value="">All essays</option>
      {essays.map((e) => <option value={e.slug}>{e.data.title}</option>)}
    </select>
    <select class="am-region" aria-label="Filter Venetian ports by region" disabled>
      <option value="">All port regions</option>
    </select>
    {
      coverage.length > 0 && (
        <select class="am-covers" aria-label="Show only maps depicted within another map's extent">
          <option value="">Depicted anywhere</option>
          {coverage.map((c) => (
            <option value={c.id}>Within {c.title}</option>
          ))}
        </select>
      )
    }
    <div class="am-time">
      <label for="am-year">Reveal through</label>
      <input
        id="am-year"
        class="am-year"
        type="range"
        min={minYear}
        max={maxYear}
        value={maxYear}
        step="1"
      />
      <output class="am-year-out" for="am-year">{formatYear(maxYear)}</output>
    </div>
    {
      toponyms.length > 0 && (
        <label class="am-topo-toggle">
          <input type="checkbox" class="am-topo-check" />
          <span>Ancient &amp; medieval place-names</span>
        </label>
      )
    }
    <div class="am-share">
      <button type="button" class="am-share-button">Copy this view</button>
      <output class="am-share-status" aria-live="polite"></output>
    </div>
  </div>

  <!-- Hanseatic gazetteer matches (KAN-311). The corpus search above indexes maps
       and essays; historic place-names live in the HSE dataset, so they get their
       own result group rather than being silently unsearchable. -->
  <div class="am-gazetteer" hidden>
    <p class="am-gazetteer-kicker">Hanseatic place-names</p>
    <ul class="am-gazetteer-list" aria-label="Matching Hanseatic place-names"></ul>
  </div>

  <div class="am-platform">
    <div class="am-stage">
      <div class="am-map" role="application" aria-label="Map of the essay corpus"></div>
      <noscript>
        <p class="am-fallback-note">
          The interactive map needs JavaScript. The full corpus is listed below.
        </p>
      </noscript>
    </div>
    <aside class="am-context" aria-live="polite" aria-atomic="true">
      <p class="am-context-kicker">Atlas context</p>
      <h3 class="am-context-title">Space and time, held together</h3>
      <p class="am-context-summary">
        Select a map pin, essay filter, layer feature, or timeline bar to keep its argument beside
        the atlas.
      </p>
      <p class="am-context-meta"></p>
      <a class="am-context-link" href="/essays/" hidden>Enter the essay →</a>
      <ul class="am-context-docs" hidden></ul>

      {
        /* Universal layer inspector (KAN-402). Every dossier is rendered here at
          build time and revealed on demand, so the apparatus costs nothing in
          the client payload and is still present without JavaScript. Focusing a
          layer never activates it. */
      }
      <div class="am-inspector" data-inspector>
        {
          browsable.map((l) => (
            <div class="am-dossier" data-dossier-for={l.id} hidden>
              <h4 class="am-dossier-title">{l.title}</h4>
              <p class="am-dossier-summary">{l.description}</p>
              <dl class="am-dossier-facts">
                <div>
                  <dt>Kind</dt>
                  <dd>
                    {l.role}
                    {l.category && ` · ${l.category.replace(/-/g, ' ')}`}
                  </dd>
                </div>
                <div>
                  <dt>Period</dt>
                  <dd>
                    {formatYear(l.yearFrom)}-{formatYear(l.yearTo)}
                  </dd>
                </div>
                <div>
                  <dt>Source</dt>
                  <dd>{l.source}</dd>
                </div>
                <div>
                  <dt>Licence</dt>
                  <dd>{l.license}</dd>
                </div>
                <div>
                  <dt>Attribution</dt>
                  <dd>{l.attribution}</dd>
                </div>
                {l.lifecycle !== 'published' && (
                  <div>
                    <dt>Status</dt>
                    <dd>{l.lifecycle}</dd>
                  </div>
                )}
              </dl>
              <p class="am-dossier-links">
                {documentationRoutes[l.id] && (
                  <a class="am-dossier-handbook" href={documentationRoutes[l.id]}>
                    Read the layer record →
                  </a>
                )}
                {l.essayLinks.map((link) => (
                  <a href={`/essays/${link.slug}/#${link.sectionId}`}>Passage: {link.label} →</a>
                ))}
                {l.essayLinks.length === 0 &&
                  (l.essaySlugs ?? [])
                    .filter((slug) => essayMeta[slug])
                    .map((slug) => (
                      <a href={`/essays/${slug}/`}>Essay: {essayMeta[slug]?.title} →</a>
                    ))}
              </p>
              {l.documentationLinks.length > 0 && (
                <details class="am-dossier-technical">
                  <summary>Advanced and technical</summary>
                  <ul>
                    {l.documentationLinks.map((doc) => (
                      <li>
                        <a href={doc.href}>{doc.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </div>
          ))
        }

        {
          /* Facet controls (KAN-340), relocated out of the catalogue rows. A panel
            shows only when its layer is both active and inspected; selections
            live in the client's facet map, so focusing another layer hides these
            controls without resetting anything. */
        }
        {
          browsable
            .filter((l) => (layerFacets[l.id] ?? []).length > 0)
            .map((l) => (
              <div class="am-facets" data-facets-for={l.id} hidden>
                <div class="am-facets-head">
                  <p class="am-facets-kicker">Filter this layer</p>
                  <button type="button" class="am-facets-clear" data-facets-clear={l.id}>
                    Clear filters
                  </button>
                </div>
                {(layerFacets[l.id] ?? []).map((facet) => (
                  <fieldset class="am-facet">
                    <legend>{facet.label}</legend>
                    {facet.values.map((v) => (
                      <label class="am-facet-value">
                        <input
                          type="checkbox"
                          data-facet-layer={l.id}
                          data-facet-field={facet.field}
                          value={v.value}
                        />
                        <span>{v.label}</span>
                        <span class="am-facet-count">{v.count}</span>
                      </label>
                    ))}
                  </fieldset>
                ))}
                <output class="am-facets-status" data-facets-status={l.id} aria-live="polite" />
              </div>
            ))
        }
      </div>
    </aside>
  </div>

  {
    catalogue.layers.length > 0 && (
      <AtlasLayerBrowser catalogue={catalogue} documentationRoutes={documentationRoutes} />
    )
  }

  <AtlasActiveLayers />

  <!-- Progressive-enhancement fallback: full corpus as a grouped list. -->
  <ol class="am-list">
    {
      corpus.map((m) => (
        <li>
          <a
            href={isEssayReleased(m.essaySlug) ? `/essays/${m.essaySlug}/` : `/collection/${m.id}/`}
          >
            <span class="am-list-year">{formatYear(m.year)}</span>
            <span class="am-list-title">{m.title}</span>
            <span class="am-list-region">{m.region}</span>
          </a>
        </li>
      ))
    }
  </ol>

  <script type="application/json" data-atlasmap-data set:html={JSON.stringify(payload)} />
</section>

<script>
  // Type-only imports are erased at build, so MapLibre (~785K) and pmtiles are
  // pulled in lazily via dynamic import() below - only once the map actually
  // initializes with WebGL present. Readers without WebGL never download them.
  import type {
    Map as MLMap,
    Marker as MLMarker,
    AddLayerObject,
    FilterSpecification,
    MapLayerMouseEvent,
    Popup as MLPopup,
  } from 'maplibre-gl';
  import {
    circleRadiusExpression,
    lineWidthExpression,
    withTemporal,
    withRegion,
    withFacets,
    dashSubLayers,
    type GraduateHint,
    type DashHint,
    type WidthHint,
  } from '../../lib/geo-style';
  import { buildAtlasShareUrl, parseAtlasShareState } from '../../lib/atlas-share';
  import {
    parseVmnAtlasState,
    resolveVmnBeatState,
    type VmnBeatState,
  } from '../../lib/vmn-atlas-state';
  import {
    hanseaticPlaceNames,
    searchHanseaticPlaces,
    type HanseaticPlacePhase,
  } from '../../lib/hanseatic';

  // Register the pmtiles:// protocol at most once across page-load re-inits.
  let protocolRegistered = false;

  type Pt = {
    id: string;
    title: string;
    year: number;
    yearLabel: string;
    essaySlug: string;
    /** Where "read more" goes: the source essay, or the map's catalogue entry
     *  while that essay is held by the staged release gate (KAN-263). */
    essayHref: string;
    essayTitle: string;
    essaySummary: string;
    essayYearFrom: number;
    essayYearTo: number;
    region: string;
    coords: [number, number];
    accent: string;
    blurb?: string;
  };

  type LayerMeta = {
    id: string;
    url: string;
    format: string;
    geometry: 'line' | 'fill' | 'circle';
    color: string;
    yearFrom: number;
    yearTo: number;
    sourceLayer: string | null;
    perFeatureTime: boolean;
    graduate: GraduateHint | null;
    dash: DashHint | null;
    width: WidthHint | null;
    documentationLinks: { label: string; href: string }[];
    essayLinks: { href: string; label: string }[];
    available: boolean;
    defaultOn: boolean;
    facets: { field: string; label: string; values: { value: string; label: string }[] }[];
  };

  type Coverage = { id: string; title: string; ring: [number, number][] };

  type EssayMeta = {
    slug: string;
    title: string;
    summary: string;
    yearFrom: number;
    yearTo: number;
    room: string;
  };

  type Toponym = {
    id: string;
    modern: string;
    names: string[];
    historical: string[];
    coords: [number, number];
    authorityLinks: Array<{ type: 'closeMatch'; identifier: string }>;
    linkedPlacesUrl: string;
    essays: { slug: string; title: string }[];
    maps: { id: string; title: string }[];
  };

  function hasWebGL(): boolean {
    try {
      const c = document.createElement('canvas');
      return !!(c.getContext('webgl2') || c.getContext('webgl'));
    } catch {
      return false;
    }
  }

  async function initAtlasMap(root: HTMLElement) {
    const dataEl = root.querySelector<HTMLElement>('[data-atlasmap-data]');
    const mapEl = root.querySelector<HTMLElement>('.am-map');
    if (!dataEl || !mapEl) return;
    const parsed = JSON.parse(dataEl.textContent || '{}') as {
      corpus: Pt[];
      essays?: EssayMeta[];
      layers?: LayerMeta[];
      vmnLinks?: VmnBeatState[];
      coverage?: Coverage[];
      toponyms?: Toponym[];
    };
    const corpus = parsed.corpus ?? [];
    const essayDetails = parsed.essays ?? [];
    const geoLayers = parsed.layers ?? [];
    const vmnLinks = parsed.vmnLinks ?? [];
    const coverage = parsed.coverage ?? [];
    const toponyms = parsed.toponyms ?? [];
    const reverseEssayLink = (layer: string) =>
      geoLayers.find((candidate) => candidate.id === layer)?.essayLinks[0];

    // Ray-casting point-in-ring, inlined (no turf.js) for the footprint filter.
    const pointInRing = (x: number, y: number, ring: [number, number][]) => {
      let inside = false;
      for (let i = 0, j = ring.length - 1; i < ring.length; j = i++) {
        const [xi, yi] = ring[i];
        const [xj, yj] = ring[j];
        if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) {
          inside = !inside;
        }
      }
      return inside;
    };

    const search = root.querySelector<HTMLInputElement>('.am-search')!;
    const essaySel = root.querySelector<HTMLSelectElement>('.am-essay')!;
    const regionSel = root.querySelector<HTMLSelectElement>('.am-region')!;
    const coversSel = root.querySelector<HTMLSelectElement>('.am-covers');
    const yearIn = root.querySelector<HTMLInputElement>('.am-year')!;
    const yearOut = root.querySelector<HTMLOutputElement>('.am-year-out')!;
    const topoCheck = root.querySelector<HTMLInputElement>('.am-topo-check');
    const shareButton = root.querySelector<HTMLButtonElement>('.am-share-button')!;
    const shareStatus = root.querySelector<HTMLOutputElement>('.am-share-status')!;
    const list = root.querySelector<HTMLElement>('.am-list')!;
    const contextTitle = root.querySelector<HTMLElement>('.am-context-title')!;
    const contextSummary = root.querySelector<HTMLElement>('.am-context-summary')!;
    const contextMeta = root.querySelector<HTMLElement>('.am-context-meta')!;
    const contextLink = root.querySelector<HTMLAnchorElement>('.am-context-link')!;
    const contextDocs = root.querySelector<HTMLElement>('.am-context-docs')!;
    const gazetteer = root.querySelector<HTMLElement>('.am-gazetteer')!;
    const gazetteerList = root.querySelector<HTMLElement>('.am-gazetteer-list')!;
    const layerToggles = Array.from(
      root.querySelectorAll<HTMLInputElement>('.am-layer input[data-layer]'),
    );
    const facetBoxes = Array.from(
      root.querySelectorAll<HTMLInputElement>('input[data-facet-layer]'),
    );

    // Facet selections (KAN-340), per layer and field. An absent or empty set
    // means "no constraint", so the resting state is everything visible.
    const facetSelections = new Map<string, Map<string, Set<string>>>();
    const selectionsFor = (layerId: string) => {
      const chosen: Record<string, string[]> = {};
      for (const [field, values] of facetSelections.get(layerId) ?? []) {
        if (values.size > 0) chosen[field] = [...values];
      }
      return chosen;
    };

    const fmt = (y: number) => (y < 0 ? `${Math.abs(y)} BC` : `AD ${y}`);

    // Where WebGL is missing, keep the list and drop the empty map frame.
    if (!hasWebGL()) {
      mapEl.remove();
      root
        .querySelector('.am-stage')
        ?.insertAdjacentHTML(
          'beforeend',
          '<p class="am-fallback-note">WebGL is unavailable - showing the corpus as a list.</p>',
        );
      list.classList.add('is-fallback');
      // Geo overlays need the GL map; disable their toggles in the fallback.
      layerToggles.forEach((cb) => {
        cb.checked = false;
        cb.disabled = true;
      });
    }

    const markers: { pt: Pt; marker?: MLMarker; li: HTMLElement }[] = [];
    const listItems = Array.from(list.querySelectorAll('li'));
    corpus.forEach((pt, i) => markers.push({ pt, li: listItems[i] }));
    for (const { pt, li } of markers) {
      const select = () =>
        showContext(
          {
            id: `map:${pt.id}`,
            title: pt.title,
            summary: pt.blurb || pt.essaySummary,
            meta: `${pt.region} · ${pt.yearLabel} · ${pt.essayTitle}`,
            href: pt.essayHref,
            essaySlug: pt.essaySlug,
            year: Number(yearIn.value),
          },
          false,
        );
      li.querySelector('a')?.addEventListener('focus', select);
      li.addEventListener('pointerenter', select);
    }

    // A dedicated concordance pin set (KAN-75), kept entirely separate from both
    // the corpus pins and the GeoLayer pipeline (addGeoLayer has no point branch).
    const topoMarkers: { topo: Toponym; marker: MLMarker }[] = [];

    let map: MLMap | null = null;
    let PopupCtor: (typeof import('maplibre-gl'))['Popup'] | null = null;
    let portPopup: MLPopup | null = null;
    let hansePopup: MLPopup | null = null;
    let targetPopup: MLPopup | null = null;
    let portPopupPinned = false;
    let hansePopupPinned = false;
    let styleReady = false;
    // Decoded VMN features, retained so ID-only deep links can focus their target
    // without re-fetching or duplicating geometry in the essay (KAN-190/191).
    let portFeatures: GeoJSON.Feature[] = [];
    let routeFeatures: GeoJSON.Feature[] = [];
    let possessionFeatures: GeoJSON.Feature[] = [];
    const layerFeatures = new Map<string, GeoJSON.Feature[]>();
    let focusedRouteId = '';
    let focusedTerritoryId = '';
    let focusedFeatureId = '';
    let focusedFeatureLayer = '';
    const activeLayers = new Set<string>();
    const layerId = (id: string) => `geolyr-${id}`;
    const sourceId = (id: string) => `geosrc-${id}`;

    // One GeoLayer can expand into several MapLibre layers (a dashed-by-field line
    // splits into a filtered sub-layer per value). We track the created ids plus
    // each sub-layer's own base filter so the temporal reveal can AND onto it.
    type Part = { id: string; baseFilter: unknown | null };
    const parts = new Map<string, Part[]>();
    const layerCleanups = new Map<string, () => void>();

    const escapeHtml = (value: unknown) => {
      const replacements: Record<string, string> = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      };
      return String(value ?? '').replace(/[&<>"']/g, (char) => replacements[char]);
    };

    const readable = (value: unknown) => String(value ?? '').replaceAll('_', ' ');

    type AtlasContext = {
      id: string;
      title: string;
      summary: string;
      meta: string;
      href: string;
      linkLabel?: string;
      essaySlug?: string;
      year?: number;
      /** Provenance links for the selected feature's layer (KAN-310). */
      documents?: { label: string; href: string }[];
    };

    const updateUrlState = (essaySlug?: string, year?: number) => {
      const url = new URL(location.href);
      if (essaySlug) url.searchParams.set('essay', essaySlug);
      else url.searchParams.delete('essay');
      if (year !== undefined) url.searchParams.set('year', String(year));
      history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
    };

    // Facet state travels in one `facets` parameter, so a filtered view is
    // shareable on the same contract as the rest of the atlas:
    //   facets=layer:field=a,b;field2=c|layer2:field=d
    const encodeFacets = () => {
      const groups: string[] = [];
      for (const layerId of [...facetSelections.keys()].sort()) {
        const chosen = selectionsFor(layerId);
        const fields = Object.keys(chosen).sort();
        if (fields.length === 0) continue;
        groups.push(
          `${layerId}:${fields.map((f) => `${f}=${[...chosen[f]].sort().join(',')}`).join(';')}`,
        );
      }
      return groups.join('|');
    };

    const updateFacetUrlState = () => {
      const url = new URL(location.href);
      const encoded = encodeFacets();
      if (encoded) url.searchParams.set('facets', encoded);
      else url.searchParams.delete('facets');
      history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
    };

    const decodeFacets = (raw: string) => {
      for (const group of raw.split('|').filter(Boolean)) {
        const [layerId, fieldsPart] = group.split(':');
        const layer = geoLayers.find((l) => l.id === layerId);
        if (!layer || !fieldsPart) continue;
        const byField = new Map<string, Set<string>>();
        for (const pair of fieldsPart.split(';').filter(Boolean)) {
          const [field, valuesPart] = pair.split('=');
          const declared = layer.facets.find((f) => f.field === field);
          if (!declared || !valuesPart) continue;
          // Only values the layer actually declares are restored, so a hand-
          // edited link cannot filter on a field that does not exist.
          const values = new Set(
            valuesPart
              .split(',')
              .filter((v) => declared.values.some((candidate) => candidate.value === v)),
          );
          if (values.size > 0) byField.set(field, values);
        }
        if (byField.size > 0) facetSelections.set(layerId, byField);
      }
    };

    const showContext = (context: AtlasContext, persist = true) => {
      contextTitle.textContent = context.title;
      contextSummary.textContent = context.summary;
      contextMeta.textContent = context.meta;
      contextLink.href = context.href;
      contextLink.textContent = context.linkLabel ?? 'Enter the essay →';
      contextLink.hidden = false;
      const documents = context.documents ?? [];
      contextDocs.replaceChildren(
        ...documents.map((doc) => {
          const item = document.createElement('li');
          const anchor = document.createElement('a');
          anchor.href = doc.href;
          anchor.textContent = doc.label;
          item.append(anchor);
          return item;
        }),
      );
      contextDocs.hidden = documents.length === 0;
      root.dataset.atlasSelection = context.id;
      if (persist) updateUrlState(context.essaySlug, context.year ?? Number(yearIn.value));
      document.dispatchEvent(
        new CustomEvent('atlas:selection', {
          detail: { ...context },
        }),
      );
    };

    const showEssayContext = (slug: string, persist = true) => {
      const essay = essayDetails.find((candidate) => candidate.slug === slug);
      if (!essay) return;
      showContext(
        {
          id: `essay:${slug}`,
          title: essay.title,
          summary: essay.summary,
          meta: `${readable(essay.room)} · ${fmt(essay.yearFrom)}–${fmt(essay.yearTo)}`,
          href: `/essays/${slug}/`,
          essaySlug: slug,
        },
        persist,
      );
    };

    const sharedState = parseAtlasShareState(location.search);
    if (sharedState.query) search.value = sharedState.query;
    if (sharedState.covers && coversSel?.querySelector(`option[value="${sharedState.covers}"]`)) {
      coversSel.value = sharedState.covers;
    }
    if (sharedState.toponyms && topoCheck) topoCheck.checked = true;
    if (sharedState.year !== undefined) {
      yearIn.value = String(
        Math.max(Number(yearIn.min), Math.min(Number(yearIn.max), sharedState.year)),
      );
    }
    const requestedEssay = sharedState.essay;
    if (requestedEssay && essayDetails.some((essay) => essay.slug === requestedEssay)) {
      essaySel.value = requestedEssay;
    }
    // Restore facet selections and tick the boxes that produced them, so the
    // panel and the map agree on arrival rather than only after a click.
    const sharedFacets = new URL(location.href).searchParams.get('facets');
    if (sharedFacets) {
      decodeFacets(sharedFacets);
      for (const box of facetBoxes) {
        const values = facetSelections.get(box.dataset.facetLayer!)?.get(box.dataset.facetField!);
        if (values?.has(box.value)) box.checked = true;
      }
    }
    const announceTime = () => {
      const year = Number(yearIn.value);
      updateUrlState(essaySel.value || undefined, year);
      document.dispatchEvent(new CustomEvent('atlas:time', { detail: { year } }));
    };
    essaySel.addEventListener('change', () => {
      if (essaySel.value) showEssayContext(essaySel.value);
      else updateUrlState(undefined, Number(yearIn.value));
    });
    yearIn.addEventListener('input', announceTime);

    shareButton.addEventListener('click', async () => {
      const base = new URL(location.href);
      const selection = root.dataset.atlasSelection;
      const target = root.dataset.atlasTarget;
      if (selection?.startsWith('map:')) base.hash = selection.slice('map:'.length);
      if (selection?.startsWith('toponym:'))
        base.hash = `topo-${selection.slice('toponym:'.length)}`;
      if (selection?.startsWith('map:') || selection?.startsWith('toponym:')) {
        for (const key of ['beat', 'port', 'route', 'territory', 'feature'])
          base.searchParams.delete(key);
      } else if (target) {
        const [kind, id] = target.split(':');
        for (const key of ['port', 'route', 'territory', 'feature']) base.searchParams.delete(key);
        if (['port', 'route', 'territory', 'feature'].includes(kind) && id)
          base.searchParams.set(kind, id);
      }
      const shareUrl = buildAtlasShareUrl(base.toString(), {
        query: search.value.trim() || undefined,
        essay: essaySel.value || undefined,
        region: regionSel.value || undefined,
        covers: coversSel?.value || undefined,
        year: Number(yearIn.value),
        zoom: map ? Number(map.getZoom().toFixed(2)) : sharedState.zoom,
        layers: layerToggles
          .filter((toggle) => toggle.checked)
          .map((toggle) => toggle.dataset.layer!),
        feature: target?.startsWith('feature:') ? target.slice('feature:'.length) : undefined,
        toponyms: topoCheck?.checked ?? false,
      });
      const url = new URL(shareUrl);
      // Re-apply after the share builder, which knows only its own contract.
      const encodedFacets = encodeFacets();
      if (encodedFacets) url.searchParams.set('facets', encodedFacets);
      else url.searchParams.delete('facets');
      history.replaceState(history.state, '', `${url.pathname}${url.search}${url.hash}`);
      try {
        await navigator.clipboard.writeText(url.toString());
        shareStatus.textContent = 'View link copied.';
      } catch {
        shareStatus.textContent = 'Copy the link from the address bar.';
      }
    });

    const portPopupHtml = (properties: Record<string, unknown>) => {
      const historic = escapeHtml(properties.name);
      const modern = escapeHtml(properties.name_modern);
      const local = escapeHtml(properties.name_local);
      const alternateNames = [local, modern]
        .filter(
          (name, index, values) => name && name !== historic && values.indexOf(name) === index,
        )
        .join(' · ');
      const dates = `${escapeHtml(properties.valid_from)}–${
        Number(properties.valid_to) === 9999 ? 'present' : escapeHtml(properties.valid_to)
      }`;
      const notes = properties.notes
        ? `<span class="am-pop-blurb">${escapeHtml(properties.notes)}</span>`
        : '';
      const essayLink = reverseEssayLink('venetian-ports');
      return (
        `<div class="am-pop am-port-pop">` +
        `<span class="am-pop-year">${dates}</span>` +
        `<strong class="am-pop-title">${historic}</strong>` +
        (alternateNames ? `<span class="am-pop-names">${alternateNames}</span>` : '') +
        `<span class="am-pop-meta">${escapeHtml(properties.region)} · ${escapeHtml(
          readable(properties.status),
        )}</span>` +
        `<span class="am-pop-meta">Polity: ${escapeHtml(readable(properties.polity_id))}</span>` +
        notes +
        (essayLink
          ? `<a class="am-pop-link" href="${escapeHtml(essayLink.href)}">${escapeHtml(
              essayLink.label,
            )} →</a>`
          : '') +
        `</div>`
      );
    };

    const showPortContext = (properties: Record<string, unknown>, persist = true) => {
      const essay = essayDetails.find((candidate) => candidate.slug === 'venice-sicily');
      const essayLink = reverseEssayLink('venetian-ports');
      const validTo =
        Number(properties.valid_to) === 9999 ? 'present' : String(properties.valid_to ?? '');
      showContext(
        {
          id: `port:${String(properties.port_id ?? '')}`,
          title: String(properties.name ?? 'Venetian maritime port'),
          summary: String(properties.notes || essay?.summary || ''),
          meta: `${String(properties.region ?? '')} · ${readable(properties.status)} · ${String(
            properties.valid_from ?? '',
          )}–${validTo}`,
          href: essayLink?.href ?? '/essays/venice-sicily/',
          linkLabel: essayLink?.label ? `${essayLink.label} →` : undefined,
          essaySlug: 'venice-sicily',
          year: Number(yearIn.value),
        },
        persist,
      );
    };

    // Hanseatic place phases (KAN-310). The panel has to carry provenance, not
    // just identity: an HSE feature is a dated claim, so the source key, the
    // certainty and the documentation links travel with it.
    const hansePopupHtml = (properties: Record<string, unknown>) => {
      const historic = escapeHtml(properties.name);
      const alternates = [escapeHtml(properties.name_historic), escapeHtml(properties.name_modern)]
        .filter(
          (name, index, values) => name && name !== historic && values.indexOf(name) === index,
        )
        .join(' · ');
      const dates = `${escapeHtml(properties.valid_from)}–${escapeHtml(properties.valid_to)}`;
      const notes = properties.notes
        ? `<span class="am-pop-blurb">${escapeHtml(properties.notes)}</span>`
        : '';
      const essayLink = reverseEssayLink('hanseatic-places');
      return (
        `<div class="am-pop am-hse-pop">` +
        `<span class="am-pop-year">${dates}</span>` +
        `<strong class="am-pop-title">${historic}</strong>` +
        (alternates ? `<span class="am-pop-names">${alternates}</span>` : '') +
        `<span class="am-pop-meta">${escapeHtml(properties.region)} · ${escapeHtml(
          readable(properties.role),
        )}</span>` +
        `<span class="am-pop-meta">${escapeHtml(readable(properties.participation_class))}</span>` +
        `<span class="am-pop-meta">${escapeHtml(properties.certainty)} certainty · source ${escapeHtml(
          properties.source,
        )}</span>` +
        notes +
        (essayLink
          ? `<a class="am-pop-link" href="${escapeHtml(essayLink.href)}">${escapeHtml(
              essayLink.label,
            )} →</a>`
          : '') +
        `</div>`
      );
    };

    const showHanseContext = (properties: Record<string, unknown>, persist = true) => {
      const layer = geoLayers.find((candidate) => candidate.id === 'hanseatic-places');
      const anchor = String(properties.essay_anchor ?? '').trim();
      // The row's own essay_anchor wins over the layer's default section, so the
      // panel lands on the passage that actually discusses this phase.
      const essayLink = reverseEssayLink('hanseatic-places');
      const href = anchor
        ? `/essays/the-league-that-left-no-map/#${anchor}`
        : (essayLink?.href ?? '/essays/the-league-that-left-no-map/');
      showContext(
        {
          id: `feature:${String(properties.id ?? '')}`,
          title: String(properties.name ?? 'Hanseatic place phase'),
          summary: String(properties.notes ?? ''),
          meta:
            `${readable(String(properties.role ?? ''))} · ` +
            `${readable(String(properties.participation_class ?? ''))} · ` +
            `${String(properties.valid_from ?? '')}–${String(properties.valid_to ?? '')} · ` +
            `${String(properties.certainty ?? '')} certainty · source ${String(properties.source ?? '')}`,
          href,
          linkLabel: essayLink?.label ? `${essayLink.label} →` : undefined,
          essaySlug: 'the-league-that-left-no-map',
          year: Number(yearIn.value),
          documents: layer?.documentationLinks ?? [],
        },
        persist,
      );
    };

    // Corpus attestations (KAN-340). Every visual state has to resolve to a
    // record: the panel names the place, what this particular source calls it,
    // the class of claim, its confidence, its locator and its review state. A
    // silence is a claim too, and says so rather than showing an empty name.
    const SILENCE_WORDING: Record<string, string> = {
      extra_muros: 'Outside this source’s scope',
      source_silent: 'In scope, and unnamed',
      not_applicable: 'The question does not arise',
      survival_unknown: 'The witness cannot be consulted',
      mapped_unlabelled: 'Drawn, but not named',
    };

    const daciaHeadline = (properties: Record<string, unknown>) => {
      const klass = String(properties.attestation_class ?? '');
      const silence = SILENCE_WORDING[klass];
      if (silence) return silence;
      const original = String(properties.name_original ?? '').trim();
      if (!original || original === 'pending') return 'Reading not yet transcribed';
      return original;
    };

    const daciaLocator = (properties: Record<string, unknown>) => {
      const type = String(properties.locator_type ?? '');
      const locator = String(properties.locator ?? '');
      if (!type || type === 'none' || !locator || locator === 'pending') return 'no locator yet';
      return `${readable(type)} ${locator}`;
    };

    const daciaPopupHtml = (properties: Record<string, unknown>) => {
      const place = escapeHtml(properties.place_name);
      const headline = escapeHtml(daciaHeadline(properties));
      const klass = escapeHtml(readable(String(properties.attestation_class ?? '')));
      const language = String(properties.language ?? '').trim();
      const script = String(properties.script ?? '').trim();
      const tongue = [language, script]
        .filter(Boolean)
        .map((v) => escapeHtml(readable(v)))
        .join(' · ');
      const review = String(properties.review_state ?? '');
      const unreviewed = review !== 'approved' && review !== 'published';
      return (
        `<div class="am-pop am-cnd-pop">` +
        `<span class="am-pop-year">${escapeHtml(properties.source_date)}</span>` +
        `<strong class="am-pop-title">${headline}</strong>` +
        `<span class="am-pop-names">${place}</span>` +
        `<span class="am-pop-meta">${klass}${tongue ? ` · ${tongue}` : ''}</span>` +
        `<span class="am-pop-meta">${escapeHtml(properties.source_title)} · ` +
        `${escapeHtml(readable(String(properties.source_family ?? '')))}</span>` +
        `<span class="am-pop-meta">${escapeHtml(
          readable(String(properties.confidence ?? '')),
        )} confidence · ${escapeHtml(daciaLocator(properties))}</span>` +
        (unreviewed
          ? `<span class="am-pop-blurb am-pop-warn">Unreviewed research record (${escapeHtml(
              review,
            )}). Not citable as established evidence.</span>`
          : '') +
        `</div>`
      );
    };

    const showDaciaContext = (
      layerId: string,
      properties: Record<string, unknown>,
      persist = true,
    ) => {
      const layer = geoLayers.find((candidate) => candidate.id === layerId);
      const essayLink = reverseEssayLink(layerId);
      const review = String(properties.review_state ?? '');
      const unreviewed = review !== 'approved' && review !== 'published';
      showContext(
        {
          id: `feature:${String(properties.id ?? '')}`,
          title: `${daciaHeadline(properties)} - ${String(properties.place_name ?? '')}`,
          summary: unreviewed
            ? `Unreviewed research record. ${readable(review)} in the corpus, and not citable as established evidence.`
            : `${readable(String(properties.attestation_class ?? ''))} in ${String(properties.source_title ?? '')}.`,
          meta:
            `${readable(String(properties.attestation_class ?? ''))} · ` +
            `${readable(String(properties.confidence ?? ''))} confidence · ` +
            `${String(properties.source_title ?? '')} (${String(properties.source_date ?? '')}) · ` +
            `${daciaLocator(properties)} · ${String(properties.region ?? '')}`,
          href: essayLink?.href ?? '/essays/dacia/',
          linkLabel: essayLink?.label ? `${essayLink.label} →` : 'Read: Terra Sigillata →',
          essaySlug: 'dacia',
          year: Number(yearIn.value),
          documents: layer?.documentationLinks ?? [],
        },
        persist,
      );
    };

    const bindDaciaInteractions = (layerId: string, renderLayerId: string) => {
      if (!map || !PopupCtor) return;
      let popup: MLPopup | null = null;
      let pinned = false;
      const show = (event: MapLayerMouseEvent, isPinned: boolean) => {
        const feature = event.features?.[0];
        if (!feature || feature.geometry.type !== 'Point' || !map || !PopupCtor) return;
        popup?.remove();
        pinned = isPinned;
        popup = new PopupCtor({ closeButton: isPinned, closeOnClick: false, offset: 12 })
          .setLngLat((feature.geometry as GeoJSON.Point).coordinates as [number, number])
          .setHTML(daciaPopupHtml((feature.properties ?? {}) as Record<string, unknown>))
          .addTo(map);
        popup.on('close', () => {
          pinned = false;
        });
      };
      const enter = (event: MapLayerMouseEvent) => {
        if (map) map.getCanvas().style.cursor = 'pointer';
        if (!pinned) show(event, false);
      };
      const leave = () => {
        if (map) map.getCanvas().style.cursor = '';
        if (!pinned) popup?.remove();
      };
      const click = (event: MapLayerMouseEvent) => show(event, true);
      const select = (event: MapLayerMouseEvent) => {
        const feature = event.features?.[0];
        if (feature) {
          showDaciaContext(layerId, (feature.properties ?? {}) as Record<string, unknown>);
        }
      };
      map.on('mouseenter', renderLayerId, enter);
      map.on('mouseleave', renderLayerId, leave);
      map.on('click', renderLayerId, click);
      map.on('click', renderLayerId, select);
      layerCleanups.set(layerId, () => {
        map?.off('mouseenter', renderLayerId, enter);
        map?.off('mouseleave', renderLayerId, leave);
        map?.off('click', renderLayerId, click);
        map?.off('click', renderLayerId, select);
        popup?.remove();
        popup = null;
        pinned = false;
      });
    };

    const bindHanseInteractions = (renderLayerId: string) => {
      if (!map || !PopupCtor) return;
      const show = (event: MapLayerMouseEvent, pinned: boolean) => {
        const feature = event.features?.[0];
        if (!feature || feature.geometry.type !== 'Point' || !map || !PopupCtor) return;
        hansePopup?.remove();
        hansePopupPinned = pinned;
        hansePopup = new PopupCtor({
          offset: 10,
          closeButton: pinned,
          closeOnClick: pinned,
        })
          .setLngLat(feature.geometry.coordinates as [number, number])
          .setHTML(hansePopupHtml((feature.properties ?? {}) as Record<string, unknown>))
          .addTo(map);
        hansePopup.on('close', () => {
          hansePopupPinned = false;
        });
      };
      const enter = (event: MapLayerMouseEvent) => {
        if (!map) return;
        map.getCanvas().style.cursor = 'pointer';
        if (!hansePopupPinned) show(event, false);
      };
      const leave = () => {
        if (!map) return;
        map.getCanvas().style.cursor = '';
        if (!hansePopupPinned) hansePopup?.remove();
      };
      const click = (event: MapLayerMouseEvent) => show(event, true);
      const select = (event: MapLayerMouseEvent) => {
        const feature = event.features?.[0];
        if (feature) {
          showHanseContext((feature.properties ?? {}) as Record<string, unknown>);
        }
      };
      map.on('mouseenter', renderLayerId, enter);
      map.on('mouseleave', renderLayerId, leave);
      map.on('click', renderLayerId, click);
      map.on('click', renderLayerId, select);
      layerCleanups.set('hanseatic-places', () => {
        map?.off('mouseenter', renderLayerId, enter);
        map?.off('mouseleave', renderLayerId, leave);
        map?.off('click', renderLayerId, click);
        map?.off('click', renderLayerId, select);
        hansePopup?.remove();
        hansePopup = null;
        hansePopupPinned = false;
      });
    };

    const setPortRegions = (features: GeoJSON.Feature[]) => {
      const selected = regionSel.value;
      const regions = [
        ...new Set(
          features
            .map((feature) => String(feature.properties?.region ?? '').trim())
            .filter(Boolean),
        ),
      ].sort((a, b) => a.localeCompare(b));
      regionSel.replaceChildren(new Option('All port regions', ''));
      for (const region of regions) regionSel.add(new Option(region, region));
      regionSel.value = regions.includes(selected) ? selected : '';
      regionSel.disabled = false;
    };

    const bindPortInteractions = (renderLayerId: string) => {
      if (!map || !PopupCtor) return;
      const show = (event: MapLayerMouseEvent, pinned: boolean) => {
        const feature = event.features?.[0];
        if (!feature || feature.geometry.type !== 'Point' || !map || !PopupCtor) return;
        portPopup?.remove();
        portPopupPinned = pinned;
        portPopup = new PopupCtor({
          offset: 10,
          closeButton: pinned,
          closeOnClick: pinned,
        })
          .setLngLat(feature.geometry.coordinates as [number, number])
          .setHTML(portPopupHtml((feature.properties ?? {}) as Record<string, unknown>))
          .addTo(map);
        portPopup.on('close', () => {
          portPopupPinned = false;
        });
      };
      const enter = (event: MapLayerMouseEvent) => {
        if (!map) return;
        map.getCanvas().style.cursor = 'pointer';
        if (!portPopupPinned) show(event, false);
      };
      const leave = () => {
        if (!map) return;
        map.getCanvas().style.cursor = '';
        if (!portPopupPinned) portPopup?.remove();
      };
      const click = (event: MapLayerMouseEvent) => show(event, true);
      const select = (event: MapLayerMouseEvent) => {
        const feature = event.features?.[0];
        if (feature) {
          showPortContext((feature.properties ?? {}) as Record<string, unknown>);
        }
      };
      map.on('mouseenter', renderLayerId, enter);
      map.on('mouseleave', renderLayerId, leave);
      map.on('click', renderLayerId, click);
      map.on('click', renderLayerId, select);
      layerCleanups.set('venetian-ports', () => {
        map?.off('mouseenter', renderLayerId, enter);
        map?.off('mouseleave', renderLayerId, leave);
        map?.off('click', renderLayerId, click);
        map?.off('click', renderLayerId, select);
        portPopup?.remove();
        portPopup = null;
        portPopupPinned = false;
      });
    };

    // Build the MapLibre render layer(s) for a GeoLayer from its geometry + hints.
    const buildParts = (
      l: LayerMeta,
      src: string,
    ): { layer: Record<string, unknown>; baseFilter: unknown | null }[] => {
      const lyr = layerId(l.id);
      const withSrcLayer = (o: Record<string, unknown>) => {
        if (l.format === 'pmtiles' && l.sourceLayer) o['source-layer'] = l.sourceLayer;
        return o;
      };
      if (l.geometry === 'fill') {
        return [
          {
            layer: withSrcLayer({
              id: lyr,
              type: 'fill',
              source: src,
              paint: { 'fill-color': l.color, 'fill-opacity': 0.22, 'fill-outline-color': l.color },
            }),
            baseFilter: null,
          },
        ];
      }
      if (l.geometry === 'circle') {
        // Graduated point symbols (ports): radius by categorical field, else flat.
        const radius = l.graduate ? circleRadiusExpression(l.graduate) : 5;
        return [
          {
            layer: withSrcLayer({
              id: lyr,
              type: 'circle',
              source: src,
              paint: {
                'circle-radius': radius,
                'circle-color': l.color,
                'circle-opacity': 0.85,
                'circle-stroke-width': 1,
                'circle-stroke-color': '#0b0b0c',
              },
            }),
            baseFilter: null,
          },
        ];
      }
      // Line - dashed by a categorical field means one filtered sub-layer per value
      // (line-dasharray is not a data-driven paint property in MapLibre).
      // Evidence strength rides on line-width, which *is* data-driven, so it
      // varies inside each dashed sub-layer instead of multiplying them.
      const lineWidth = l.width ? lineWidthExpression(l.width) : 1.2;
      if (l.dash) {
        return dashSubLayers(l.dash).map((s) => {
          const paint: Record<string, unknown> = {
            'line-color': l.color,
            'line-width': lineWidth,
            'line-opacity': 0.85,
          };
          if (s.dashArray.length) paint['line-dasharray'] = s.dashArray;
          return {
            layer: withSrcLayer({
              id: `${lyr}--${s.value}`,
              type: 'line',
              source: src,
              filter: s.filter,
              paint,
            }),
            baseFilter: s.filter,
          };
        });
      }
      return [
        {
          layer: withSrcLayer({
            id: lyr,
            type: 'line',
            source: src,
            paint: { 'line-color': l.color, 'line-width': lineWidth, 'line-opacity': 0.85 },
          }),
          baseFilter: null,
        },
      ];
    };

    // Attach a GeoLayer's source + render layer(s) to the map. GeoJSON loads
    // directly; PMTiles goes through the registered pmtiles:// protocol; FlatGeobuf
    // is fetched and deserialized to a GeoJSON source via a lazily-loaded decoder
    // (VMN-2 blocker B1) - the decoder chunk only ships when an FGB layer is toggled.
    const addGeoLayer = async (l: LayerMeta) => {
      if (!map || !styleReady || map.getSource(sourceId(l.id))) return;
      const src = sourceId(l.id);
      if (l.format === 'geojson') {
        if (sharedState.feature && sharedState.layers?.includes(l.id)) {
          try {
            const response = await fetch(l.url);
            if (!response.ok) return;
            const data = (await response.json()) as GeoJSON.FeatureCollection;
            const features = Array.isArray(data.features) ? data.features : [];
            layerFeatures.set(l.id, features);
            map.addSource(src, { type: 'geojson', data });
          } catch {
            return;
          }
        } else {
          map.addSource(src, { type: 'geojson', data: l.url });
        }
      } else if (l.format === 'pmtiles') {
        map.addSource(src, { type: 'vector', url: `pmtiles://${location.origin}${l.url}` });
      } else if (l.format === 'flatgeobuf') {
        try {
          const [{ geojson }, resp] = await Promise.all([import('flatgeobuf'), fetch(l.url)]);
          if (!map || !resp.ok || map.getSource(src)) return;
          const buf = new Uint8Array(await resp.arrayBuffer());
          // deserialize streams features as an async generator; collect into a
          // GeoJSON source MapLibre can consume.
          const features: GeoJSON.Feature[] = [];
          for await (const f of geojson.deserialize(buf)) {
            features.push(f as unknown as GeoJSON.Feature);
          }
          if (!map || map.getSource(src)) return;
          map.addSource(src, { type: 'geojson', data: { type: 'FeatureCollection', features } });
          layerFeatures.set(l.id, features);
          if (l.id === 'venetian-ports') {
            setPortRegions(features);
            portFeatures = features;
          }
          if (l.id === 'venetian-routes') routeFeatures = features;
          if (l.id === 'venetian-possessions') possessionFeatures = features;
        } catch {
          return; // asset missing or malformed - leave the layer pending
        }
      } else {
        return; // cog needs a dedicated raster loader
      }
      if (!map) return;
      const built = buildParts(l, src);
      for (const b of built) map.addLayer(b.layer as unknown as AddLayerObject);
      parts.set(
        l.id,
        built.map((b) => ({ id: b.layer.id as string, baseFilter: b.baseFilter })),
      );
      if (l.id === 'venetian-ports' && built[0]) {
        bindPortInteractions(built[0].layer.id as string);
      }
      if (l.id === 'hanseatic-places' && built[0]) {
        bindHanseInteractions(built[0].layer.id as string);
      }
      if (l.id.startsWith('dacia-attestations') && built[0]) {
        bindDaciaInteractions(l.id, built[0].layer.id as string);
      }
      syncLayerTime(Number(yearIn.value));
    };

    const removeGeoLayer = (id: string) => {
      if (!map) return;
      layerCleanups.get(id)?.();
      layerCleanups.delete(id);
      const focusId = `${layerId(id)}--focus`;
      if (map.getLayer(focusId)) map.removeLayer(focusId);
      for (const p of parts.get(id) ?? []) {
        if (map.getLayer(p.id)) map.removeLayer(p.id);
      }
      if (map.getSource(sourceId(id))) map.removeSource(sourceId(id));
      parts.delete(id);
      layerFeatures.delete(id);
      if (focusedFeatureLayer === id) {
        focusedFeatureId = '';
        focusedFeatureLayer = '';
      }
      if (id === 'venetian-ports') {
        portFeatures = [];
        regionSel.disabled = true;
      }
      if (id === 'venetian-routes') {
        routeFeatures = [];
        focusedRouteId = '';
        targetPopup?.remove();
      }
      if (id === 'venetian-possessions') {
        possessionFeatures = [];
        focusedTerritoryId = '';
        targetPopup?.remove();
      }
    };

    const syncTargetHighlights = (cutoff: number) => {
      if (!map) return;
      const targets: [string, string, string][] = [
        ['venetian-routes', 'route_id', focusedRouteId],
        ['venetian-possessions', 'territory', focusedTerritoryId],
      ];
      for (const [id, field, value] of targets) {
        const focusId = `${layerId(id)}--focus`;
        if (value && map.getLayer(focusId)) {
          map.setFilter(
            focusId,
            withTemporal(['==', ['get', field], value], cutoff) as FilterSpecification,
          );
        }
      }
      if (focusedFeatureId && focusedFeatureLayer) {
        const focusId = `${layerId(focusedFeatureLayer)}--focus`;
        if (map.getLayer(focusId)) {
          const layer = geoLayers.find((candidate) => candidate.id === focusedFeatureLayer);
          const idFilter = ['==', ['get', 'id'], focusedFeatureId];
          map.setFilter(
            focusId,
            (layer?.perFeatureTime
              ? withTemporal(idFilter, cutoff)
              : idFilter) as FilterSpecification,
          );
        }
      }
    };

    // Timeline sync. The layer envelope (registry yearFrom/yearTo) still gates
    // whole-layer visibility; on top, a per-feature layer (VMN phased model, blocker
    // B2) filters individual features by their inclusive valid_from/valid_to.
    const syncLayerTime = (cutoff: number) => {
      if (!map || !styleReady) return;
      for (const l of geoLayers) {
        const ps = parts.get(l.id);
        if (!activeLayers.has(l.id) || !ps) continue;
        const envelopeVisible = l.yearFrom <= cutoff;
        for (const p of ps) {
          if (!map.getLayer(p.id)) continue;
          map.setLayoutProperty(p.id, 'visibility', envelopeVisible ? 'visible' : 'none');
          // Recomputed whenever the layer can be narrowed at all, so clearing a
          // facet restores the unfiltered layer instead of leaving a stale one.
          if (l.perFeatureTime || l.facets.length > 0) {
            const temporal = l.perFeatureTime ? withTemporal(p.baseFilter, cutoff) : p.baseFilter;
            const regional =
              l.id === 'venetian-ports' ? withRegion(temporal, regionSel.value) : temporal;
            const filtered = withFacets(regional, selectionsFor(l.id));
            map.setFilter(p.id, (filtered ?? null) as FilterSpecification);
          }
        }
      }
      syncTargetHighlights(cutoff);
    };

    if (mapEl.isConnected) {
      // Pull the heavy GL + tiling libs only now, when we're really rendering.
      const [{ default: maplibregl }, { Protocol }] = await Promise.all([
        import('maplibre-gl'),
        import('pmtiles'),
      ]);
      PopupCtor = maplibregl.Popup;
      if (!protocolRegistered) {
        maplibregl.addProtocol('pmtiles', new Protocol().tile);
        protocolRegistered = true;
      }

      map = new maplibregl.Map({
        container: mapEl,
        style: 'https://demotiles.maplibre.org/style.json',
        center: [12, 41],
        zoom: 2.4,
        attributionControl: { compact: true },
      });
      map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

      for (const entry of markers) {
        const { pt } = entry;
        const el = document.createElement('button');
        el.className = 'am-pin';
        el.style.setProperty('--accent', pt.accent);
        el.setAttribute('aria-label', `${pt.title} (${pt.yearLabel})`);
        el.addEventListener('click', () => {
          showContext({
            id: `map:${pt.id}`,
            title: pt.title,
            summary: pt.blurb || pt.essaySummary,
            meta: `${pt.region} · ${pt.yearLabel} · ${pt.essayTitle}`,
            href: pt.essayHref,
            essaySlug: pt.essaySlug,
            year: Number(yearIn.value),
          });
        });
        const popup = new maplibregl.Popup({ offset: 14, closeButton: false }).setHTML(
          `<div class="am-pop"><span class="am-pop-year">${pt.yearLabel}</span>` +
            `<strong class="am-pop-title">${pt.title}</strong>` +
            (pt.blurb ? `<span class="am-pop-blurb">${pt.blurb}</span>` : '') +
            `<a class="am-pop-link" href="${pt.essayHref}">${pt.essayTitle} →</a></div>`,
        );
        entry.marker = new maplibregl.Marker({ element: el })
          .setLngLat(pt.coords)
          .setPopup(popup)
          .addTo(map);
      }

      // Toponym pins - a distinct marker set with multi-name popups, hidden until
      // the reader toggles them on (or a #topo-<id> deep-link requests one).
      for (const topo of toponyms) {
        const el = document.createElement('button');
        el.className = 'am-topo-pin';
        el.setAttribute('aria-label', `${topo.modern} - historical names`);
        const names = topo.historical.length
          ? `<ul class="am-topo-names">${topo.historical.map((n) => `<li>${n}</li>`).join('')}</ul>`
          : '';
        const links = [
          ...topo.maps.map(
            (m) => `<a class="am-pop-link" href="/collection/${m.id}/">${m.title} →</a>`,
          ),
          ...topo.essays.map(
            (e) => `<a class="am-pop-link" href="/essays/${e.slug}/">${e.title} →</a>`,
          ),
        ].join('');
        const authorityLinks = topo.authorityLinks
          .map(({ identifier }) => {
            const label = identifier.includes('pleiades.stoa.org')
              ? 'Pleiades'
              : 'World Historical Gazetteer';
            return `<a class="am-pop-link" href="${identifier}" target="_blank" rel="noopener">${label} ↗</a>`;
          })
          .join('');
        const popup = new maplibregl.Popup({ offset: 12, closeButton: false }).setHTML(
          `<div class="am-pop am-topo-pop"><span class="am-pop-year">Place-names</span>` +
            `<strong class="am-pop-title">${topo.modern}</strong>` +
            names +
            links +
            authorityLinks +
            `<a class="am-pop-link" href="${topo.linkedPlacesUrl}">Linked Places record →</a>` +
            `<a class="am-pop-link" href="https://pelagios.org/lod/tools-resources" target="_blank" rel="noopener">Pelagios tools ↗</a>` +
            `</div>`,
        );
        const marker = new maplibregl.Marker({ element: el })
          .setLngLat(topo.coords)
          .setPopup(popup)
          .addTo(map);
        el.style.display = 'none'; // off until toggled / deep-linked
        topoMarkers.push({ topo, marker });
      }

      map.on('load', () => {
        styleReady = true;
        // Honour any default-on / already-checked layer toggles.
        for (const cb of layerToggles) {
          if (cb.checked && !cb.disabled) {
            const l = geoLayers.find((x) => x.id === cb.dataset.layer);
            if (l) {
              activeLayers.add(l.id);
              addGeoLayer(l);
            }
          }
        }
        setTopoVisible(topoCheck?.checked ?? false);
        syncLayerTime(Number(yearIn.value));
        applyDeepLink();
      });
    }

    // Toggle the concordance pin set on/off as one group.
    const setTopoVisible = (on: boolean) => {
      for (const { marker } of topoMarkers) {
        marker.getElement().style.display = on ? '' : 'none';
        if (!on) marker.getPopup()?.remove();
      }
    };
    topoCheck?.addEventListener('change', () => setTopoVisible(topoCheck.checked));

    // Fly to a Venetian port and open its popover, choosing the phase valid at the
    // current cutoff (VMN-28). Requires the ports layer to be loaded first.
    const focusPort = (portId: string) => {
      if (!map || !PopupCtor) return;
      const matches = portFeatures.filter(
        (feature) => String(feature.properties?.port_id) === portId,
      );
      if (!matches.length) return;
      const cutoff = Number(yearIn.value);
      const chosen =
        matches.find(
          (feature) =>
            Number(feature.properties?.valid_from) <= cutoff &&
            cutoff <= Number(feature.properties?.valid_to),
        ) ?? matches[0];
      if (chosen.geometry.type !== 'Point') return;
      root.dataset.atlasTarget = `port:${portId}`;
      showPortContext((chosen.properties ?? {}) as Record<string, unknown>);
      const coords = chosen.geometry.coordinates as [number, number];
      const open = () => {
        map!.flyTo({ center: coords, zoom: 5.5 });
        portPopup?.remove();
        portPopupPinned = true;
        portPopup = new PopupCtor!({ offset: 10, closeButton: true, closeOnClick: true })
          .setLngLat(coords)
          .setHTML(portPopupHtml((chosen.properties ?? {}) as Record<string, unknown>))
          .addTo(map!);
        portPopup.on('close', () => {
          portPopupPinned = false;
        });
      };
      if (styleReady) open();
      else map.once('load', open);
    };

    const featureBounds = (
      feature: GeoJSON.Feature,
    ): [[number, number], [number, number]] | null => {
      let minLongitude = Infinity;
      let minLatitude = Infinity;
      let maxLongitude = -Infinity;
      let maxLatitude = -Infinity;
      const collect = (value: unknown) => {
        if (
          Array.isArray(value) &&
          value.length >= 2 &&
          typeof value[0] === 'number' &&
          typeof value[1] === 'number'
        ) {
          minLongitude = Math.min(minLongitude, value[0]);
          minLatitude = Math.min(minLatitude, value[1]);
          maxLongitude = Math.max(maxLongitude, value[0]);
          maxLatitude = Math.max(maxLatitude, value[1]);
          return;
        }
        if (Array.isArray(value)) value.forEach(collect);
      };
      collect(
        feature.geometry && 'coordinates' in feature.geometry ? feature.geometry.coordinates : [],
      );
      if (!Number.isFinite(minLongitude)) return null;
      return [
        [minLongitude, minLatitude],
        [maxLongitude, maxLatitude],
      ];
    };

    const focusLineTarget = (
      sourceLayerId: 'venetian-routes' | 'venetian-possessions',
      features: GeoJSON.Feature[],
      field: 'route_id' | 'territory',
      value: string,
    ) => {
      if (!map) return;
      const feature = features.find((candidate) => String(candidate.properties?.[field]) === value);
      if (!feature) return;
      root.dataset.atlasTarget =
        sourceLayerId === 'venetian-routes' ? `route:${value}` : `territory:${value}`;
      const essay = essayDetails.find((candidate) => candidate.slug === 'venice-sicily');
      const essayLink = reverseEssayLink(sourceLayerId);
      showContext({
        id: `${sourceLayerId === 'venetian-routes' ? 'route' : 'territory'}:${value}`,
        title: String(feature.properties?.name || readable(value)),
        summary: String(feature.properties?.notes || essay?.summary || ''),
        meta: `${sourceLayerId === 'venetian-routes' ? 'Maritime route' : 'Venetian territory'} · ${fmt(
          Number(yearIn.value),
        )}`,
        href: essayLink?.href ?? '/essays/venice-sicily/',
        linkLabel: essayLink?.label ? `${essayLink.label} →` : undefined,
        essaySlug: 'venice-sicily',
        year: Number(yearIn.value),
      });
      if (sourceLayerId === 'venetian-routes') focusedRouteId = value;
      else focusedTerritoryId = value;
      const focusId = `${layerId(sourceLayerId)}--focus`;
      const filter = withTemporal(
        ['==', ['get', field], value],
        Number(yearIn.value),
      ) as FilterSpecification;
      if (!map.getLayer(focusId)) {
        map.addLayer({
          id: focusId,
          type: 'line',
          source: sourceId(sourceLayerId),
          filter,
          paint: {
            'line-color': '#f4d06f',
            'line-width': sourceLayerId === 'venetian-routes' ? 4 : 2.5,
            'line-opacity': 1,
          },
        });
      } else {
        map.setFilter(focusId, filter);
      }
      const bounds = featureBounds(feature);
      if (bounds) {
        map.fitBounds(bounds, { padding: 72, maxZoom: 6 });
        if (PopupCtor && essayLink) {
          targetPopup?.remove();
          targetPopup = new PopupCtor({ offset: 8, closeButton: true, closeOnClick: true })
            .setLngLat([(bounds[0][0] + bounds[1][0]) / 2, (bounds[0][1] + bounds[1][1]) / 2])
            .setHTML(
              `<div class="am-pop am-target-pop">` +
                `<span class="am-pop-year">${sourceLayerId === 'venetian-routes' ? 'Route' : 'Territory'}</span>` +
                `<strong class="am-pop-title">${escapeHtml(readable(value))}</strong>` +
                `<a class="am-pop-link" href="${escapeHtml(essayLink.href)}">${escapeHtml(
                  essayLink.label,
                )} →</a></div>`,
            )
            .addTo(map);
        }
      }
    };

    const focusFeatureTarget = (value: string, requestedLayers: string[]) => {
      if (!map) return;
      for (const sourceLayerId of requestedLayers) {
        const feature = (layerFeatures.get(sourceLayerId) ?? []).find(
          (candidate) => String(candidate.properties?.id) === value,
        );
        const layer = geoLayers.find((candidate) => candidate.id === sourceLayerId);
        if (!feature || !layer) continue;

        root.dataset.atlasTarget = `feature:${value}`;
        focusedFeatureId = value;
        focusedFeatureLayer = sourceLayerId;
        const essayLink = reverseEssayLink(sourceLayerId);
        const properties = (feature.properties ?? {}) as Record<string, unknown>;
        // A deep-linked HSE phase must read exactly like a clicked one, or the
        // shared link quietly shows less provenance than the map does (KAN-311).
        if (sourceLayerId === 'hanseatic-places') {
          showHanseContext(properties, false);
        } else {
          showContext(
            {
              id: `feature:${value}`,
              title: String(properties.name || readable(value)),
              summary: String(properties.notes || layer.id),
              meta: `${readable(sourceLayerId)} · ${fmt(Number(yearIn.value))}`,
              href: essayLink?.href ?? '/atlas/',
              linkLabel: essayLink?.label ? `${essayLink.label} →` : 'Explore the Atlas →',
              year: Number(yearIn.value),
            },
            false,
          );
        }

        const focusId = `${layerId(sourceLayerId)}--focus`;
        const idFilter = ['==', ['get', 'id'], value];
        const filter = (
          layer.perFeatureTime ? withTemporal(idFilter, Number(yearIn.value)) : idFilter
        ) as FilterSpecification;
        if (!map.getLayer(focusId)) {
          if (layer.geometry === 'circle') {
            map.addLayer({
              id: focusId,
              type: 'circle',
              source: sourceId(sourceLayerId),
              filter,
              paint: {
                'circle-radius': 11,
                'circle-color': '#f4d06f',
                'circle-opacity': 1,
                'circle-stroke-width': 2,
                'circle-stroke-color': '#0b0b0c',
              },
            });
          } else {
            map.addLayer({
              id: focusId,
              type: 'line',
              source: sourceId(sourceLayerId),
              filter,
              paint: {
                'line-color': '#f4d06f',
                'line-width': 4,
                'line-opacity': 1,
              },
            });
          }
        } else {
          map.setFilter(focusId, filter);
        }

        if (feature.geometry.type === 'Point') {
          map.flyTo({ center: feature.geometry.coordinates as [number, number], zoom: 6 });
        } else {
          const bounds = featureBounds(feature);
          if (bounds) map.fitBounds(bounds, { padding: 72, maxZoom: 6 });
        }
        return;
      }
    };

    // Query-param deep links (KAN-189/190/191, KAN-302):
    // /atlas?year=<n>&zoom=<n>&layers=<a,b>&feature=<stable-id> plus the VMN
    // beat/port/route/territory aliases. Generic features require an explicit
    // layer so IDs never need to be globally unique across datasets.
    const applyDeepLink = async () => {
      const state = resolveVmnBeatState(parseVmnAtlasState(location.search), vmnLinks);
      delete root.dataset.atlasTarget;
      targetPopup?.remove();
      if (state.year !== undefined) {
        yearIn.value = String(
          Math.max(Number(yearIn.min), Math.min(Number(yearIn.max), state.year)),
        );
      }
      const wanted = new Set([...(sharedState.layers ?? []), ...(state.layers ?? [])]);
      if (state.port) wanted.add('venetian-ports');
      if (state.route) wanted.add('venetian-routes');
      if (state.territory) wanted.add('venetian-possessions');
      for (const id of wanted) {
        const cb = layerToggles.find((toggle) => toggle.dataset.layer === id);
        if (cb && !cb.disabled && !cb.checked) {
          cb.checked = true;
          activeLayers.add(id);
          const l = geoLayers.find((x) => x.id === id);
          if (l) await addGeoLayer(l);
        }
        syncFacetPanel(id);
      }
      if (
        sharedState.region &&
        !regionSel.disabled &&
        regionSel.querySelector(`option[value="${sharedState.region}"]`)
      ) {
        regionSel.value = sharedState.region;
      }
      apply();
      if (state.zoom !== undefined && map) {
        map.setZoom(Math.max(0, Math.min(18, state.zoom)));
      }
      if (state.port) focusPort(state.port);
      if (state.route) {
        focusLineTarget('venetian-routes', routeFeatures, 'route_id', state.route);
      }
      if (state.territory) {
        focusLineTarget('venetian-possessions', possessionFeatures, 'territory', state.territory);
      }
      if (sharedState.feature) {
        focusFeatureTarget(sharedState.feature, [...wanted]);
      }
    };

    // Deep-link support: /atlas/#<map-id> flies to and opens that pin (KAN-68);
    // /atlas/#topo-<id> reveals the concordance set and opens that place (KAN-75).
    // In the no-WebGL fallback it scrolls the corresponding list item into view.
    const focusFromHash = () => {
      const raw = decodeURIComponent(location.hash.replace(/^#/, ''));
      if (!raw) return;
      if (raw.startsWith('topo-')) {
        const entry = topoMarkers.find((t) => t.topo.id === raw.slice('topo-'.length));
        if (!entry || !map) return;
        const relatedEssay = entry.topo.essays[0];
        const relatedMap = entry.topo.maps[0];
        showContext({
          id: `toponym:${entry.topo.id}`,
          title: entry.topo.modern,
          summary: entry.topo.historical.length
            ? `Also charted as ${entry.topo.historical.join(', ')}.`
            : 'A place-name shared across the atlas corpus.',
          meta: `${entry.topo.maps.length} map references · ${entry.topo.essays.length} essays`,
          href: relatedEssay
            ? `/essays/${relatedEssay.slug}/`
            : relatedMap
              ? `/collection/${relatedMap.id}/`
              : '/essays/',
          essaySlug: relatedEssay?.slug,
        });
        if (topoCheck && !topoCheck.checked) topoCheck.checked = true;
        const open = () => {
          setTopoVisible(true);
          map!.flyTo({ center: entry.topo.coords, zoom: 5 });
          if (!entry.marker.getPopup()?.isOpen()) entry.marker.togglePopup();
        };
        if (styleReady) open();
        else map.once('load', open);
        return;
      }
      const id = raw;
      const entry = markers.find((m) => m.pt.id === id);
      if (!entry) return;
      showContext({
        id: `map:${entry.pt.id}`,
        title: entry.pt.title,
        summary: entry.pt.blurb || entry.pt.essaySummary,
        meta: `${entry.pt.region} · ${entry.pt.yearLabel} · ${entry.pt.essayTitle}`,
        href: entry.pt.essayHref,
        essaySlug: entry.pt.essaySlug,
        year: Number(yearIn.value),
      });
      if (map) {
        const open = () => {
          map!.flyTo({ center: entry.pt.coords, zoom: 4.5 });
          if (entry.marker && !entry.marker.getPopup()?.isOpen()) entry.marker.togglePopup();
        };
        if (styleReady) open();
        else map.once('load', open);
      } else {
        entry.li.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    };
    // Re-run on hash changes; keep a single listener across page-load re-inits.
    const w = window as unknown as { __amHashHandler?: () => void };
    if (w.__amHashHandler) window.removeEventListener('hashchange', w.__amHashHandler);
    w.__amHashHandler = focusFromHash;
    window.addEventListener('hashchange', focusFromHash);
    focusFromHash();

    // Facet panels follow their layer: visible only while it is drawn. The
    // status is refreshed with the panel so a selection restored from a shared
    // link reads correctly the moment its layer is switched on.
    const syncFacetPanel = (layerId: string) => {
      const panel = root.querySelector<HTMLElement>(`[data-facets-for="${layerId}"]`);
      if (!panel) return;
      panel.hidden = !activeLayers.has(layerId);
      const status = root.querySelector<HTMLElement>(`[data-facets-status="${layerId}"]`);
      if (status && !panel.hidden) status.textContent = describeFacets(layerId);
    };

    const describeFacets = (layerId: string) => {
      const chosen = selectionsFor(layerId);
      const fields = Object.keys(chosen);
      if (fields.length === 0) return 'No filters: showing every record in this layer.';
      const parts = fields.map((field) => {
        const facet = geoLayers
          .find((l) => l.id === layerId)
          ?.facets.find((f) => f.field === field);
        // Sorted, not click-ordered: the announcement should read the same for
        // the same selection however it was arrived at.
        const labels = chosen[field]
          .map((value) => facet?.values.find((v) => v.value === value)?.label ?? readable(value))
          .sort((a, b) => a.localeCompare(b));
        return `${facet?.label ?? readable(field)}: ${labels.join(', ')}`;
      });
      return `Filtered by ${parts.join('; ')}.`;
    };

    const applyFacets = (layerId: string) => {
      const status = root.querySelector<HTMLElement>(`[data-facets-status="${layerId}"]`);
      if (status) status.textContent = describeFacets(layerId);
      updateFacetUrlState();
      syncLayerTime(Number(yearIn.value));
    };

    for (const box of facetBoxes) {
      box.addEventListener('change', () => {
        const layerId = box.dataset.facetLayer!;
        const field = box.dataset.facetField!;
        const byField = facetSelections.get(layerId) ?? new Map<string, Set<string>>();
        const values = byField.get(field) ?? new Set<string>();
        if (box.checked) values.add(box.value);
        else values.delete(box.value);
        byField.set(field, values);
        facetSelections.set(layerId, byField);
        applyFacets(layerId);
      });
    }

    for (const button of Array.from(
      root.querySelectorAll<HTMLButtonElement>('[data-facets-clear]'),
    )) {
      button.addEventListener('click', () => {
        const layerId = button.dataset.facetsClear!;
        facetSelections.delete(layerId);
        for (const box of facetBoxes) {
          if (box.dataset.facetLayer === layerId) box.checked = false;
        }
        applyFacets(layerId);
      });
    }

    for (const cb of layerToggles) {
      cb.addEventListener('change', () => {
        const l = geoLayers.find((x) => x.id === cb.dataset.layer);
        if (!l) return;
        if (cb.checked) {
          activeLayers.add(l.id);
          addGeoLayer(l);
          syncLayerTime(Number(yearIn.value));
        } else {
          activeLayers.delete(l.id);
          removeGeoLayer(l.id);
        }
        syncFacetPanel(l.id);
        updateFacetUrlState();
      });
    }

    // Each match is a real link on the documented deep-link contract, so it is
    // keyboard-reachable and shareable, and it exercises the same state
    // restoration an essay link uses rather than a second, private code path.
    const renderGazetteer = (query: string) => {
      const matches: HanseaticPlacePhase[] = searchHanseaticPlaces(query);
      gazetteerList.replaceChildren(
        ...matches.map((phase) => {
          const item = document.createElement('li');
          const anchor = document.createElement('a');
          anchor.href = `/atlas?year=${phase.valid_from}&layers=hanseatic-places&feature=${encodeURIComponent(phase.id)}`;
          const names = hanseaticPlaceNames(phase);
          anchor.textContent = names[0];
          const rest = names.slice(1);
          if (rest.length) {
            const alias = document.createElement('span');
            alias.className = 'am-gazetteer-alias';
            alias.textContent = ` ${rest.join(' · ')}`;
            anchor.append(alias);
          }
          const span = document.createElement('span');
          span.className = 'am-gazetteer-span';
          span.textContent = ` AD ${phase.valid_from}–${phase.valid_to}`;
          item.append(anchor, span);
          return item;
        }),
      );
      gazetteer.hidden = matches.length === 0;
    };

    const apply = () => {
      const q = search.value.trim().toLowerCase();
      renderGazetteer(search.value);
      const slug = essaySel.value;
      const cutoff = Number(yearIn.value);
      // Footprint filter: keep only pins that fall inside the selected map's ring.
      const footprint = coversSel?.value
        ? coverage.find((c) => c.id === coversSel.value)
        : undefined;
      yearOut.textContent = fmt(cutoff);
      for (const { pt, marker, li } of markers) {
        const matchText =
          !q ||
          pt.title.toLowerCase().includes(q) ||
          pt.region.toLowerCase().includes(q) ||
          pt.essayTitle.toLowerCase().includes(q);
        const matchEssay = !slug || pt.essaySlug === slug;
        const matchYear = pt.year <= cutoff;
        const matchFootprint =
          !footprint || pointInRing(pt.coords[0], pt.coords[1], footprint.ring);
        const show = matchText && matchEssay && matchYear && matchFootprint;
        if (marker) marker.getElement().style.display = show ? '' : 'none';
        li.style.display = show ? '' : 'none';
      }
      syncLayerTime(cutoff);
    };

    search.addEventListener('input', apply);
    essaySel.addEventListener('change', apply);
    coversSel?.addEventListener('change', apply);
    yearIn.addEventListener('input', apply);
    regionSel.addEventListener('change', apply);

    const receiveEssaySelection = ((event: Event) => {
      const slug = (event as CustomEvent<{ slug?: string }>).detail?.slug;
      if (!slug || !essayDetails.some((essay) => essay.slug === slug)) return;
      essaySel.value = slug;
      apply();
      showEssayContext(slug);
    }) as EventListener;
    const atlasWindow = window as unknown as { __amEssaySelection?: EventListener };
    if (atlasWindow.__amEssaySelection) {
      document.removeEventListener('atlas:essay', atlasWindow.__amEssaySelection);
    }
    atlasWindow.__amEssaySelection = receiveEssaySelection;
    document.addEventListener('atlas:essay', receiveEssaySelection);

    apply();
    if (requestedEssay) showEssayContext(requestedEssay, false);
    document.dispatchEvent(
      new CustomEvent('atlas:time', { detail: { year: Number(yearIn.value) } }),
    );
    // In the no-WebGL fallback there is no map 'load' event to drive the deep link,
    // so honour at least the ?year= param here (layers/port need the GL map).
    if (!map) applyDeepLink();
  }

  const boot = () =>
    document.querySelectorAll<HTMLElement>('[data-atlasmap]').forEach((el) => {
      if (!el.dataset.atlasmapReady) {
        el.dataset.atlasmapReady = '1';
        initAtlasMap(el);
      }
    });
  boot();
  document.addEventListener('astro:page-load', boot);
</script>

