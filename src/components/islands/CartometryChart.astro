---
import states from '../../../data/editorial/maps-that-age/states.json';

const sorted = [...states].sort((a, b) => a.year - b.year || a.plate - b.plate);
const maximum = sorted.length;
---

<figure class="cartometry" data-cartometry-chart>
  <header>
    <p class="eyebrow">Cartometry Bench · evidence before precision</p>
    <h3>Documented interventions accumulate</h3>
    <p>
      The measure counts cited changes in the plate lineage. It does not calculate geographic or
      pixel error across unlike scans.
    </p>
  </header>

  <ol class="cb-bars">
    {
      sorted.map((state, index) => (
        <li>
          <span class="cb-label">
            {state.year} · {state.state}
          </span>
          <span
            class="cb-track"
            role="img"
            aria-label={`${index + 1} cumulative documented interventions by ${state.year}`}
          >
            <span class="cb-fill" style={`width:${((index + 1) / maximum) * 100}%`} />
          </span>
          <strong>{index + 1}</strong>
        </li>
      ))
    }
  </ol>

  <figcaption>
    Download the reviewable source data:
    <a href="/data/cartometry/maps-that-age.csv" download>CSV</a>
    ·
    <a href="/data/cartometry/maps-that-age.json" download>JSON</a>.
  </figcaption>
</figure>

<style>
  .cartometry {
    margin: 2.5rem 0;
    padding: clamp(1rem, 3vw, 1.6rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .cartometry header {
    max-width: 46rem;
  }
  .cartometry h3 {
    margin: 0.3rem 0 0.5rem;
  }
  .cb-bars {
    display: grid;
    gap: 0.55rem;
    list-style: none;
    padding: 0;
  }
  .cb-bars li {
    display: grid;
    grid-template-columns: 7rem minmax(6rem, 1fr) 2rem;
    align-items: center;
    gap: 0.7rem;
  }
  .cb-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-muted);
  }
  .cb-track {
    height: 0.75rem;
    border-radius: 999px;
    overflow: hidden;
    background: var(--panel-2);
  }
  .cb-fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, var(--gold), #b78d62);
  }
  .cb-bars strong {
    color: var(--gold);
  }
  figcaption {
    margin-top: 1rem;
    color: var(--ink-muted);
  }
  figcaption a {
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }
  @media (max-width: 34rem) {
    .cb-bars li {
      grid-template-columns: 5.5rem minmax(4rem, 1fr) 1.5rem;
      gap: 0.45rem;
    }
  }
</style>
