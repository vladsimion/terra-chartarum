---
/**
 * The Road proof: a drawn itinerary beside the ground it names (KAN-386).
 *
 * Matthew Paris's itinerary is a strip diagram - a vertical column of towns with
 * day-marks between them - and it has no scale, no orientation and no
 * coordinates. The comparison this island exists for is between that sequence
 * and where those towns actually are, and the whole difficulty is that the
 * comparison is something *we* are doing. The thirteenth century did not.
 *
 * So the two halves are drawn as two halves and never composited. The left is
 * the diagram's own order and duration; the right is a modern reference plot,
 * labelled as one. Selecting a stage highlights it on both sides, which is the
 * acceptance criterion, but nothing merges them into a single "corrected"
 * picture - that would answer the question the essay is asking.
 *
 * The manuscript itself is absent, and that absence is deliberate rather than
 * unfinished: no folio in this corpus has been transcribed and no witness is
 * rights-cleared, so there is nothing to show and the panel says so. When
 * KAN-384 clears a witness this island gains an image; until then it must not
 * imply it has seen one.
 */
import { getItinerary, depictedJourneyLength } from '../../lib/crusades';

const stages = getItinerary();
const { days, stagesWithMarks } = depictedJourneyLength();

// A plain equirectangular plot. Not a projection claim - it is the cheapest way
// to put fourteen reference points in roughly the right relation to each other,
// and the caption says as much. A MapLibre instance here would be heavier and
// would also dress modern reference coordinates up as cartography.
const PAD = 8;
const lons = stages.map((s) => s.modernReference[0]);
const lats = stages.map((s) => s.modernReference[1]);
const [minLon, maxLon] = [Math.min(...lons), Math.max(...lons)];
const [minLat, maxLat] = [Math.min(...lats), Math.max(...lats)];
const spanLon = maxLon - minLon || 1;
const spanLat = maxLat - minLat || 1;

const points = stages.map((stage) => ({
  ...stage,
  x: PAD + ((stage.modernReference[0] - minLon) / spanLon) * (100 - PAD * 2),
  // Latitude increases northward; SVG y increases downward.
  y: PAD + ((maxLat - stage.modernReference[1]) / spanLat) * (100 - PAD * 2),
}));

const MODE_LABELS: Record<string, string> = {
  road: 'road',
  sea: 'sea crossing',
  pass: 'mountain pass',
};

const variantCount = stages.filter((stage) => stage.variantNote).length;
const unlocated = stages.filter((stage) => stage.sourceLocator === 'pending').length;
---

<figure class="itinerary" data-itinerary>
  <div class="itinerary-grid">
    <div class="itinerary-side">
      <h3 class="itinerary-heading">The diagram</h3>
      <p class="itinerary-sub">Order and duration. No scale, no orientation, no coordinates.</p>
      <ol class="strip" aria-label="Itinerary stages as the manuscript draws them">
        {
          points.map((stage, index) => (
            <li>
              <button
                type="button"
                class:list={['strip-stage', index === 0 && 'is-selected']}
                aria-pressed={index === 0 ? 'true' : 'false'}
                data-stage={stage.id}
                tabindex={index === 0 ? 0 : -1}
              >
                <span class="strip-label">{stage.manuscriptLabel}</span>
                <span class="strip-meta">
                  {stage.depictedDays !== null && (
                    <span class="strip-days">
                      {stage.depictedDays} day-mark{stage.depictedDays === 1 ? '' : 's'}
                    </span>
                  )}
                  <span class="strip-mode" data-mode={stage.mode}>
                    {MODE_LABELS[stage.mode] ?? stage.mode}
                  </span>
                  {stage.variantNote && <span class="strip-variant">witnesses differ</span>}
                </span>
              </button>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="itinerary-side">
      <h3 class="itinerary-heading">The ground</h3>
      <p class="itinerary-sub">
        Modern reference positions for the places the diagram names. The manuscript supplies none of
        them.
      </p>
      <svg
        class="plot"
        viewBox="0 0 100 100"
        preserveAspectRatio="xMidYMid meet"
        role="img"
        aria-label="Modern reference positions of the fourteen places named by the itinerary"
      >
        {
          points.map((stage, index) => (
            <g class:list={['plot-point', index === 0 && 'is-selected']} data-point={stage.id}>
              <circle cx={stage.x} cy={stage.y} r="2.6" />
              <text x={stage.x} y={stage.y - 4}>
                {stage.modernName}
              </text>
            </g>
          ))
        }
      </svg>
    </div>
  </div>

  <div class="itinerary-readout" aria-live="polite">
    {
      points.map((stage, index) => (
        <div class="readout" data-readout={stage.id} hidden={index !== 0}>
          <p class="readout-title">
            <strong>{stage.manuscriptLabel}</strong>
            {stage.manuscriptLabel !== stage.modernName && <span> · today {stage.modernName}</span>}
          </p>
          <p class="readout-note">{stage.notes}</p>
          {stage.variantNote && <p class="readout-variant">{stage.variantNote}</p>}
          <dl class="readout-evidence">
            <div>
              <>
                <dt>Folio</dt>
                <dd>
                  {stage.sourceLocator === 'pending' ? (
                    <em>not transcribed</em>
                  ) : (
                    stage.sourceLocator
                  )}
                </dd>
              </>
            </div>
            <div>
              <>
                <dt>Evidence</dt>
                <dd>{stage.evidenceClass.replaceAll('_', ' ')}</dd>
              </>
            </div>
            <div>
              <>
                <dt>Confidence</dt>
                <dd>{stage.confidence}</dd>
              </>
            </div>
            <div>
              <>
                <dt>Position</dt>
                <dd>{stage.geometryProvenance.replaceAll('_', ' ')}</dd>
              </>
            </div>
          </dl>
        </div>
      ))
    }
  </div>

  <figcaption>
    Fourteen stages carrying <strong>{days} day-marks</strong> across {stagesWithMarks} of them. The day-marks
    are what the diagram draws; nothing here converts them into a travel time, because that would turn
    the manuscript's claim into a measurement. {variantCount} stages are drawn where the witnesses disagree.
    The plot on the right is an equirectangular scatter of modern reference points, not a reconstruction
    of any medieval projection. All {unlocated} stages remain untranscribed, so no manuscript image is
    shown here and none may be.
  </figcaption>
</figure>

<script>
  function initialise(root: HTMLElement) {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';

    const stages = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-stage]'));
    const points = Array.from(root.querySelectorAll<SVGGElement>('[data-point]'));
    const readouts = Array.from(root.querySelectorAll<HTMLElement>('[data-readout]'));

    function select(id: string, focus: boolean) {
      for (const stage of stages) {
        const on = stage.dataset.stage === id;
        stage.classList.toggle('is-selected', on);
        stage.setAttribute('aria-pressed', on ? 'true' : 'false');
        // Roving tabindex: the listbox is one tab stop and arrows move within it.
        stage.tabIndex = on ? 0 : -1;
        if (on && focus) stage.focus();
      }
      for (const point of points) {
        point.classList.toggle('is-selected', point.dataset.point === id);
      }
      for (const readout of readouts) {
        readout.hidden = readout.dataset.readout !== id;
      }
    }

    stages.forEach((stage, index) => {
      stage.addEventListener('click', () => select(stage.dataset.stage!, false));
      stage.addEventListener('keydown', (event) => {
        const delta =
          event.key === 'ArrowDown' || event.key === 'ArrowRight'
            ? 1
            : event.key === 'ArrowUp' || event.key === 'ArrowLeft'
              ? -1
              : event.key === 'Home'
                ? -index
                : event.key === 'End'
                  ? stages.length - 1 - index
                  : 0;
        if (!delta) return;
        event.preventDefault();
        const next = Math.min(stages.length - 1, Math.max(0, index + delta));
        select(stages[next].dataset.stage!, true);
      });
    });

    // The plot is a second way into the same selection. Pointer only: the
    // stages already provide the keyboard path, and duplicating it here would
    // put every place in the tab order twice for no gain.
    for (const point of points) {
      point.addEventListener('click', () => select(point.dataset.point!, false));
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-itinerary]')) {
    initialise(root);
  }
</script>

<style>
  .itinerary {
    margin: 2.5rem 0;
    padding: 1.25rem;
    border: 1px solid var(--rule, #3a3226);
    border-radius: 4px;
    background: var(--surface-raised, #17130e);
  }

  .itinerary-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 46rem) {
    .itinerary-grid {
      grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    }
  }

  .itinerary-heading {
    margin: 0 0 0.15rem;
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .itinerary-sub {
    margin: 0 0 0.85rem;
    font-size: 0.82rem;
    opacity: 0.72;
  }

  .strip {
    list-style: none;
    margin: 0;
    padding: 0;
    max-height: 26rem;
    overflow-y: auto;
  }

  /* The connecting rule is the day-mark column the diagram draws. */
  .strip li + li {
    border-top: 1px dashed var(--rule, #3a3226);
  }

  .strip-stage {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    width: 100%;
    padding: 0.5rem 0.6rem;
    border: 0;
    border-left: 3px solid transparent;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
  }

  .strip-stage:hover {
    background: color-mix(in srgb, var(--gold, #d4b87a) 8%, transparent);
  }

  .strip-stage.is-selected {
    border-left-color: var(--gold, #d4b87a);
    background: color-mix(in srgb, var(--gold, #d4b87a) 14%, transparent);
  }

  .strip-stage:focus-visible {
    outline: 2px solid var(--gold, #d4b87a);
    outline-offset: -2px;
  }

  .strip-label {
    font-weight: 600;
  }

  .strip-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.75rem;
    opacity: 0.75;
  }

  /* The sea crossing is drawn in the same units as a day's walk. Marking the
     mode keeps that visible without redrawing it as a different kind of line. */
  .strip-mode[data-mode='sea'],
  .strip-mode[data-mode='pass'] {
    color: var(--gold, #d4b87a);
    opacity: 0.95;
  }

  .strip-variant {
    font-style: italic;
  }

  .plot {
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    max-height: 26rem;
  }

  .plot-point circle {
    fill: color-mix(in srgb, var(--ink, #e8dcc8) 45%, transparent);
    cursor: pointer;
    transition: fill 120ms ease;
  }

  .plot-point text {
    font-size: 3px;
    fill: var(--ink, #e8dcc8);
    opacity: 0.55;
    text-anchor: middle;
    pointer-events: none;
  }

  .plot-point.is-selected circle {
    fill: var(--gold, #d4b87a);
  }

  .plot-point.is-selected text {
    opacity: 1;
  }

  .itinerary-readout {
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--rule, #3a3226);
  }

  .readout-title {
    margin: 0 0 0.35rem;
  }

  .readout-note,
  .readout-variant {
    margin: 0 0 0.5rem;
    font-size: 0.87rem;
    opacity: 0.85;
  }

  .readout-variant {
    font-style: italic;
  }

  .readout-evidence {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.5rem;
    margin: 0;
    font-size: 0.78rem;
  }

  .readout-evidence div {
    display: flex;
    gap: 0.4rem;
  }

  .readout-evidence dt {
    opacity: 0.6;
  }

  .readout-evidence dd {
    margin: 0;
  }

  figcaption {
    margin-top: 1rem;
    font-size: 0.8rem;
    line-height: 1.55;
    opacity: 0.72;
  }

  @media (prefers-reduced-motion: reduce) {
    .plot-point circle {
      transition: none;
    }
  }
</style>
