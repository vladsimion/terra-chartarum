---
import SiteSearch from './islands/SiteSearch.astro';
import { isPrimaryNavActive, PRIMARY_NAV } from '../data/navigation';

const path = Astro.url.pathname;
---

<!-- The header is deliberately NOT transition:persist (KAN-64). An unnamed
     persist scope is numbered per page from the count of transition:* directives
     rendered before it, so the id differed between routes; a swap across that
     boundary discarded the live header - listeners and all - and kept inert
     markup, which is what killed site search away from the home page. Letting
     the header re-render also keeps aria-current honest. SiteSearch re-binds on
     astro:page-load like every other island here. -->
<header class="site-header">
  <div class="shell header-inner">
    <a href="/" class="brand" aria-label="Terra Chartarum - home">
      <span class="brand-mark" aria-hidden="true">✦</span>
      <span class="brand-name">Terra Chartarum</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isPrimaryNavActive(path, item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <SiteSearch />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--canvas) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    padding-block: 0.85rem;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: var(--step-1);
    letter-spacing: 0.04em;
  }
  .brand:hover {
    color: var(--gold);
  }
  .brand-mark {
    color: var(--gold);
    font-size: 0.8em;
  }
  /* All seven links stay visible (KAN-65). The list used to be pinned to
     width: max-content inside an overflow-x: auto box with the scrollbar hidden,
     so it overflowed at every viewport - including the widest desktop - and the
     last two items (About, Colophon) read as missing rather than scrolled. It now
     shrinks and, once a single row no longer fits, wraps; the footer nav has done
     the same since the scaffold. */
  nav {
    flex: 1 1 auto;
    min-width: 0;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.35rem clamp(0.6rem, 1.5vw, 1.05rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--ink-muted);
    padding-block: 0.25rem;
    border-bottom: 1px solid transparent;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--gold);
  }
  @media (max-width: 640px) {
    .brand-name {
      display: none;
    }
    nav ul {
      gap: 0.3rem 0.7rem;
    }
  }
</style>
