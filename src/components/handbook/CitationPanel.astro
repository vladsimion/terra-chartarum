---
/**
 * Citation, licence and download panel (ATLAS-1215 / KAN-411).
 *
 * Version and licence come from the document's citation metadata; the stable
 * URL is the page itself, because the page is the citable public record. The
 * asset link is offered separately: citing a layer and downloading it are
 * different acts and the panel should not blur them.
 */
interface Props {
  route: string;
  citation?: { version: string; licence: string; stableUrl?: string };
  assetUrl?: string;
  attribution?: string;
  lastReviewed?: string;
}

const { route, citation, assetUrl, attribution, lastReviewed } = Astro.props;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
const stableUrl = citation?.stableUrl ?? `${site}${route}`;
---

<section class="cite" aria-labelledby="cite-title">
  <h2 id="cite-title">Citation and reuse</h2>
  <dl>
    <div><dt>Stable URL</dt><dd><a href={route}>{stableUrl}</a></dd></div>
    {
      citation && (
        <div>
          <>
            <dt>Version</dt>
            <dd>
              <code>{citation.version}</code>
            </dd>
          </>
        </div>
      )
    }
    {
      citation && (
        <div>
          <>
            <dt>Licence</dt>
            <dd>{citation.licence}</dd>
          </>
        </div>
      )
    }
    {
      attribution && (
        <div>
          <>
            <dt>Attribution</dt>
            <dd>{attribution}</dd>
          </>
        </div>
      )
    }
    {
      lastReviewed && (
        <div>
          <>
            <dt>Last reviewed</dt>
            <dd>{lastReviewed}</dd>
          </>
        </div>
      )
    }
  </dl>
  {
    assetUrl && (
      <p class="asset">
        The data itself is served from the content-addressed release:{' '}
        <a href={assetUrl}>download this layer</a>. A given URL always returns the same bytes.
      </p>
    )
  }
  <p class="note">
    Attribution must travel with any reuse. Where a layer carries a third-party licence, that
    licence governs the data regardless of this page.
  </p>
</section>

<style>
  .cite {
    margin-block: 2.5rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--rule, #3a352b);
    border-radius: 4px;
  }
  .cite h2 {
    margin-block: 0 1rem;
    font-size: 1rem;
  }
  dl {
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }
  dl div {
    display: grid;
    gap: 0.15rem;
  }
  @media (min-width: 40rem) {
    dl div {
      grid-template-columns: 10rem minmax(0, 1fr);
      gap: 1rem;
    }
  }
  dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted, #8a8171);
  }
  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .asset,
  .note {
    margin-block: 1rem 0;
    font-size: 0.9rem;
  }
  .note {
    color: var(--muted, #8a8171);
  }
</style>
