---
import { ViewTransitions } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
// Self-hosted fonts (KAN-53 / ATLAS-602): bundled same-origin woff2 via
// @fontsource, replacing the render-blocking Google Fonts CDN. Variable faces
// cover every weight in one file each; italic is only pulled for the body
// families that use it. All are font-display: swap and unicode-range subset,
// so browsers fetch only the latin glyphs actually rendered.
import '@fontsource-variable/cinzel/wght.css';
import '@fontsource-variable/crimson-pro/wght.css';
import '@fontsource-variable/crimson-pro/wght-italic.css';
import '@fontsource-variable/eb-garamond/wght.css';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import cinzelLatinUrl from '@fontsource-variable/cinzel/files/cinzel-latin-wght-normal.woff2?url';
import crimsonProLatinUrl from '@fontsource-variable/crimson-pro/files/crimson-pro-latin-wght-normal.woff2?url';
import ibmPlexMonoLatinUrl from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-400-normal.woff2?url';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Hide the shared chrome (used by the full-bleed essay host route). */
  bare?: boolean;
  ogImage?: string;
  /** Alt text for the social card; falls back to the page title. */
  ogImageAlt?: string;
  /**
   * Used verbatim as <title> and og:title, bypassing the `· Terra Chartarum`
   * suffix rule below. The home page needs this: its `title` *is* the site name,
   * so the suffix rule would leave it with a bare brand word and no subject.
   */
  seoTitle?: string;
  /** Essay routes are articles; everything else is a website page. */
  ogType?: 'website' | 'article';
  /** ISO dates - emitted as article:published_time / :modified_time. */
  publishedAt?: string;
  updatedAt?: string;
  /** Keep the page out of search results while still following its links. */
  noindex?: boolean;
  /** JSON-LD block(s) describing this page - see ../lib/structured-data.ts. */
  schema?: object | object[];
}

const {
  title,
  description = 'An interactive historical atlas - a gallery of cartographic visual essays.',
  bare = false,
  ogImage = '/og/default.png',
  ogImageAlt,
  seoTitle,
  ogType = 'website',
  publishedAt,
  updatedAt,
  noindex = false,
  schema,
} = Astro.props;

const siteName = 'Terra Chartarum';
const fullTitle = seoTitle ?? (title === siteName ? title : `${title} · ${siteName}`);
const canonical = new URL(Astro.url.pathname, Astro.site);

// One <script type="application/ld+json"> per page: a lone object stays an
// object, several become the array form crawlers already expect. Escaping `<`
// is what stops a title containing "</script>" from closing the block early -
// JSON.stringify alone does not escape it.
const schemaBlocks = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
const schemaJson = schemaBlocks.length
  ? JSON.stringify(schemaBlocks.length === 1 ? schemaBlocks[0] : schemaBlocks).replace(
      /</g,
      '\\u003c',
    )
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0806" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,follow" />}
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Terra Chartarum - Essays"
      href="/rss.xml"
    />

    <!-- Open Graph / social -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt ?? title} />
    {
      ogType === 'article' && publishedAt && (
        <meta property="article:published_time" content={publishedAt} />
      )
    }
    {
      ogType === 'article' && updatedAt && (
        <meta property="article:modified_time" content={updatedAt} />
      )
    }
    <!-- X/Twitter and several link scrapers do not reliably fall back to the
         og: equivalents, so the title/description are repeated rather than
         inherited. -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={ogImageAlt ?? title} />
    <!-- is:inline: JSON-LD is data, not a module - Astro must ship it verbatim
         rather than treat it as a script to bundle. -->
    {schemaJson && <script type="application/ld+json" is:inline set:html={schemaJson} />}

    <!-- Preload the three faces visible above the fold. Besides removing a
         request round-trip, this keeps the shell and essay measure stable at
         first paint rather than shifting when font-display swaps the faces. -->
    <link rel="preload" href={cinzelLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={crimsonProLatinUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={ibmPlexMonoLatinUrl} as="font" type="font/woff2" crossorigin />

    <ViewTransitions />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {!bare && <Header />}
    <main id="main-content" tabindex="-1" class="flex-1">
      <slot />
    </main>
    {!bare && <Footer />}

    <script>
      // A11y (KAN-52): Astro's view transitions swap the DOM without moving
      // focus, which strands keyboard and screen-reader users on a now-removed
      // element. After each swap, send focus to the top of the new page's main
      // content (which is tabindex="-1" and shows no focus box) so the next Tab
      // continues from a sensible place. Registered once; persists across swaps.
      document.addEventListener('astro:after-swap', () => {
        document.getElementById('main-content')?.focus({ preventScroll: true });
      });

      // The sticky header grows a row when the primary nav wraps (KAN-65), so
      // publish its measured height as --header-h rather than letting anchor
      // offsets hardcode a one-row guess and land sections under the header.
      let headerObserver: ResizeObserver | undefined;
      const trackHeaderHeight = () => {
        const header = document.querySelector<HTMLElement>('.site-header');
        if (!header) return;
        const publish = () =>
          document.documentElement.style.setProperty('--header-h', `${header.offsetHeight}px`);
        headerObserver?.disconnect();
        headerObserver = new ResizeObserver(publish);
        headerObserver.observe(header);
        publish();
      };
      trackHeaderHeight();
      document.addEventListener('astro:page-load', trackHeaderHeight);
    </script>
  </body>
</html>
