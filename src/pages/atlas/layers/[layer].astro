---
/**
 * Public layer documentation page (ATLAS-1215 / KAN-411).
 *
 * `/atlas/layers/{canonical-layer-id}/`. The route IS the canonical ID - there
 * is no alias and no second slug, because the epic exists to stop one layer
 * having two identities.
 *
 * One template serves both a full scholarly record and a minimal context record.
 * Natural Earth's boundaries do not owe a reader a reconstruction-and-uncertainty
 * section; they owe a source, a licence and an anachronism warning, and the
 * template renders exactly what the document carries.
 */
import HandbookShell from '../../../components/handbook/HandbookShell.astro';
import CitationPanel from '../../../components/handbook/CitationPanel.astro';
import TechnicalLinks from '../../../components/handbook/TechnicalLinks.astro';
import { loadHandbook } from '../../../lib/handbook-content';
import { renderHandbookMarkdown } from '../../../lib/handbook-render';
import { GEO_LAYERS } from '../../../lib/geo';
import { collectionsForLayer } from '../../../lib/geo-collections';
import { GEO_RELEASE, geoReleaseAsset, versionedGeoUrl } from '../../../lib/geo-release';
import type { CiteInput } from '../../../lib/cite';
import { HANDBOOK_ROOT, handbookRoute } from '../../../lib/handbook';
import { breadcrumbSchema, datasetSchema } from '../../../lib/structured-data';

export async function getStaticPaths() {
  const projection = await loadHandbook();
  return projection.docs
    .filter((entry) => entry.doc.docType === 'layer' && entry.doc.layerId)
    .map((entry) => ({ params: { layer: entry.doc.layerId! }, props: { entry } }));
}

const { entry } = Astro.props;
const doc = entry.doc;
const layer = GEO_LAYERS.find((candidate) => candidate.id === doc.layerId)!;
const { html, headings } = await renderHandbookMarkdown(entry.body);
const collections = collectionsForLayer(layer.id);

// The dataset offer (KAN-416). A layer whose asset is not in the release
// manifest still documents fine; it simply has nothing to hand over.
let dataset:
  | {
      input: CiteInput;
      format: string;
      featureCount?: number;
      bytes: number;
      url: string;
      release: string;
    }
  | undefined;
try {
  const asset = geoReleaseAsset(layer.id);
  dataset = {
    input: {
      id: `${layer.id}-${asset.version}`,
      kind: 'dataset',
      title: layer.title,
      author: layer.attribution,
      publisher: 'Terra Chartarum',
      version: asset.version,
      license: layer.license,
      url: new URL(asset.url, Astro.site).toString(),
      release: GEO_RELEASE,
      checksum: asset.sha256,
    },
    format: asset.format,
    featureCount: asset.featureCount,
    bytes: asset.bytes,
    url: versionedGeoUrl(layer),
    release: GEO_RELEASE,
  };
} catch {
  dataset = undefined;
}

const span = `${layer.yearFrom < 0 ? `${Math.abs(layer.yearFrom)} BC` : layer.yearFrom}–${layer.yearTo}`;
// Deep link through the existing Atlas share contract (atlas-share.ts), not a
// second URL scheme invented for the Handbook.
const openInAtlas = `/atlas/?layers=${layer.id}&year=${Math.max(layer.yearFrom, 0)}`;

// Related navigation by canonical ID (KAN-417), so a reader can move between a
// layer, the method it shares and the layers that share it without going back
// to the catalogue.
const projection = await loadHandbook();
const byId = new Map(projection.docs.map((candidate) => [candidate.doc.id, candidate]));
const references = doc.referencesDocIds
  .map((id) => byId.get(id))
  .filter((candidate): candidate is NonNullable<typeof candidate> => Boolean(candidate));
const relatedLayers = doc.relatedLayerIds
  .map((id) => projection.docs.find((c) => c.doc.docType === 'layer' && c.doc.layerId === id))
  .filter((candidate): candidate is NonNullable<typeof candidate> => Boolean(candidate));

const schema = [
  datasetSchema(
    {
      layerId: layer.id,
      title: doc.title,
      description: doc.summary,
      licence: doc.citation?.licence ?? layer.license,
      version: doc.citation?.version,
      attribution: layer.attribution,
      temporalFrom: layer.yearFrom,
      temporalTo: layer.yearTo,
      keywords: layer.tags,
      distribution: dataset
        ? { url: dataset.url, format: dataset.format, bytes: dataset.bytes }
        : undefined,
    },
    Astro.site!,
  ),
  breadcrumbSchema(
    [
      { name: 'Atlas', path: '/atlas/' },
      { name: 'Handbook', path: HANDBOOK_ROOT },
      { name: 'Layers', path: `${HANDBOOK_ROOT}layers/` },
      { name: doc.title, path: `/atlas/layers/${layer.id}/` },
    ],
    Astro.site!,
  ),
];
---

<HandbookShell
  title={doc.title}
  description={doc.summary}
  eyebrow={doc.minimalContext ? 'Context layer' : 'Atlas layer'}
  breadcrumbs={[
    { label: 'Atlas', href: '/atlas/' },
    { label: 'Handbook', href: HANDBOOK_ROOT },
    { label: 'Layers', href: `${HANDBOOK_ROOT}layers/` },
    { label: doc.title },
  ]}
  headings={headings}
  schema={schema}
>
  <Fragment slot="header">
    <p class="lede">{doc.summary}</p>
    <dl class="facts">
      <div><dt>Canonical ID</dt><dd><code>{layer.id}</code></dd></div>
      <div><dt>Period</dt><dd>{span}</dd></div>
      <div><dt>Role</dt><dd>{layer.role}</dd></div>
      {
        layer.category && (
          <div>
            <>
              <dt>Category</dt>
              <dd>{layer.category.replace(/-/g, ' ')}</dd>
            </>
          </div>
        )
      }
      <div><dt>Status</dt><dd>{layer.lifecycle}</dd></div>
    </dl>
    {
      doc.anachronismNote && (
        <p class="anachronism" role="note">
          <strong>Anachronism warning.</strong> {doc.anachronismNote}
        </p>
      )
    }
    <p class="actions">
      <a class="open-atlas" data-open-atlas href={openInAtlas}>Open in Atlas &rarr;</a>
    </p>
    {
      collections.length > 0 && (
        <p class="member">
          Part of{' '}
          {collections.map((collection, index) => (
            <>
              {index > 0 && <span aria-hidden="true">, </span>}
              <a href={`/atlas/?collection=${collection.id}`}>{collection.title}</a>
            </>
          ))}
        </p>
      )
    }
  </Fragment>

  <div class="prose" set:html={html} />

  {
    (references.length > 0 || relatedLayers.length > 0) && (
      <section class="related" aria-labelledby="related-records">
        <h2 id="related-records">Related records</h2>
        <ul>
          {references.map((entry) => (
            <li>
              <a href={handbookRoute(entry.doc)}>{entry.doc.title}</a>
              <span class="related-kind"> · {entry.doc.docType.replace(/-/g, ' ')}</span>
            </li>
          ))}
          {relatedLayers.map((entry) => (
            <li>
              <a href={handbookRoute(entry.doc)}>{entry.doc.title}</a>
              <span class="related-kind"> · layer</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    doc.relatedEssaySlugs.length > 0 && (
      <section class="related" aria-labelledby="related-title">
        <h2 id="related-title">Related essays</h2>
        <ul>
          {doc.relatedEssaySlugs.map((slug) => (
            <li>
              <a href={`/essays/${slug}/`}>{slug.replace(/-/g, ' ')}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <CitationPanel
    route={`/atlas/layers/${layer.id}/`}
    citation={doc.citation}
    dataset={dataset}
    attribution={layer.attribution}
    lastReviewed={doc.lastReviewed}
    dataRestriction={doc.dataRestriction}
  />

  <TechnicalLinks links={doc.technicalLinks} />
</HandbookShell>

<style>
  .lede {
    font-size: 1.15rem;
    max-width: 40rem;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-block: 1.25rem;
  }
  .facts div {
    display: grid;
    gap: 0.1rem;
  }
  .facts dt {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--muted, #8a8171);
  }
  .facts dd {
    margin: 0;
  }
  .anachronism {
    border-left: 3px solid var(--accent, #d4b87a);
    padding: 0.5rem 0 0.5rem 1rem;
    max-width: 40rem;
  }
  .actions {
    margin-block: 1.25rem 0.5rem;
  }
  .open-atlas {
    display: inline-block;
    border: 1px solid var(--rule, #3a352b);
    padding: 0.4rem 0.9rem;
    border-radius: 3px;
  }
  .member {
    font-size: 0.9rem;
    color: var(--muted, #8a8171);
  }
  .related ul {
    padding-left: 1.1rem;
  }
  .related h2 {
    font-size: 1rem;
  }
  .related-kind {
    font-size: 0.78rem;
    color: var(--muted, #8a8171);
  }
</style>

<script>
  /**
   * Restore the view the reader arrived from (KAN-415).
   *
   * The Atlas puts its current year and composition on the About & sources
   * link. If they are on this page's own URL, hand them back rather than
   * dropping the reader into a default view of a layer they were already
   * looking at. Absent them - arriving from search, or a bare link - the
   * server-rendered default stands.
   */
  function restoreReturnState() {
    const link = document.querySelector<HTMLAnchorElement>('[data-open-atlas]');
    if (!link) return;
    const here = new URLSearchParams(location.search);
    const year = here.get('year');
    const layers = here.get('layers');
    if (!year && !layers) return;

    const target = new URL(link.href, location.origin);
    if (year && /^-?\d+$/.test(year)) target.searchParams.set('year', year);
    if (layers && /^[a-z0-9,_-]+$/i.test(layers)) target.searchParams.set('layers', layers);
    link.href = `${target.pathname}${target.search}`;
  }
  restoreReturnState();
  document.addEventListener('astro:page-load', restoreReturnState);
</script>
