---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getCorpus, getMapById, centuryLabel } from '../../lib/corpus';
import type { HistoricalMap } from '../../lib/corpus';
import { getCartographerById } from '../../lib/cartographers';
import { resolveMapBibliography } from '../../lib/bibliography';
import { getEssays, formatYear } from '../../lib/registry';
import CiteExport from '../../components/islands/CiteExport.astro';
import DeepZoomViewer from '../../components/islands/DeepZoomViewer.astro';
import type { CiteInput } from '../../lib/cite';
import { mapSchema, breadcrumbSchema } from '../../lib/structured-data';

export async function getStaticPaths() {
  return getCorpus().map((map) => ({ params: { id: map.id }, props: { map } }));
}

interface Props {
  map: HistoricalMap;
}
const { map } = Astro.props;

const essays = await getEssays();
const essayMeta = Object.fromEntries(
  essays.map((e) => [e.slug, { title: e.data.title, accent: e.data.accent ?? '#d4b87a' }]),
);
const accent = essayMeta[map.essaySlug]?.accent ?? 'var(--gold)';
const sourceEssayTitle = essayMeta[map.essaySlug]?.title ?? null;

// Cartographer resolves to a registry profile when linked (KAN-71/72); the
// name falls back to the free-text field otherwise.
const cartographer = map.cartographerId ? getCartographerById(map.cartographerId) : undefined;
const cartographerName = cartographer?.name ?? map.cartographer;

// Metadata rows - only rendered when a value is present, so the sparse seed
// records don't show a table full of blanks (KAN-68). Cartographer is handled
// separately so it can render as a link to the profile.
const metaRows: [string, string | undefined][] = [
  ['Publisher', map.publisher],
  ['Engraver', map.engraver],
  ['Edition', map.edition],
  ['State', map.state],
  ['Dimensions', map.dimensions],
  ['Scale', map.scale],
  ['Medium', map.medium],
  ['Condition', map.condition],
  ['Provenance', map.provenance],
  ['Acquisition', map.acquisition],
  ['Object type', map.objectType],
  ['Repository', map.repository],
  ['Repository ID', map.repositoryId],
  ['Rights', map.rightsStatement],
  ['Attribution', map.attribution],
  ['Publication status', map.publicationStatus?.replaceAll('_', ' ')],
];
const rows = metaRows.filter(([, v]) => v);

// Physical observation and open questions (TC-CAT-2 / KAN-391).
//
// These render as their own sections rather than as more rows in the table
// above, because the table mixes what the literature says the object is with
// what somebody saw when they held it, and the whole point of the observation
// record is that those are different kinds of claim. A reader who cannot tell
// them apart on the page gains nothing from their being apart in the schema.
const observation = map.physicalObservation;
const observationRows: [string, string | undefined][] = observation
  ? [
      ['Verso', observation.verso],
      ['Colour', observation.colour],
      ['Folds', observation.folds],
      ['Condition', observation.conditionNotes],
    ]
  : [];
const observedRows = observationRows.filter(([, value]) => value);
const OBSERVATION_BASIS: Record<string, string> = {
  object_in_hand: 'the object in hand',
  high_resolution_image: 'a high-resolution reproduction',
  institutional_record: 'an institutional record',
};

const relatedMaps = map.relatedMapIds
  .map((id) => getMapById(id))
  .filter((m): m is HistoricalMap => Boolean(m));
// Related essays: explicit links plus the map's own source essay.
const relatedEssaySlugs = Array.from(new Set([map.essaySlug, ...map.relatedEssaySlugs])).filter(
  (slug) => essayMeta[slug],
);

const bibliography = resolveMapBibliography(map);

// Citation payload (KAN-79) - resolved author + canonical URL; the island builds
// the BibTeX/RIS/Chicago strings client-side from this.
const citeInput: CiteInput = {
  id: map.id,
  title: map.title,
  year: map.year,
  author: cartographerName,
  publisher: map.publisher,
  place: map.region,
  url: new URL(`/collection/${map.id}/`, Astro.site).toString(),
};

const cover = map.images[0];
// A high-res tiled source (DeepZoom .dzi or IIIF info.json) opts the cover into
// the pan/zoom viewer (KAN-69); OpenSeadragon auto-detects which from the string.
const tileSource = cover?.dziTileSource ?? cover?.iiif;
---

<PortalLayout
  title={map.title}
  description={map.blurb ?? `${map.title} - ${formatYear(map.year)}, ${map.region}.`}
  schema={[
    mapSchema(map, Astro.site!, cartographer),
    breadcrumbSchema(
      [
        { name: 'Collection', path: '/collection/' },
        { name: map.title, path: `/collection/${map.id}/` },
      ],
      Astro.site!,
    ),
  ]}
>
  <article class="shell detail" style={`--accent:${accent}`}>
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/collection/">Collection</a>
      <span aria-hidden="true">/</span>
      <span>{map.title}</span>
    </nav>

    <header class="detail-head">
      <p class="eyebrow">{formatYear(map.year)} · {centuryLabel(map.year)} · {map.region}</p>
      <h1>{map.title}</h1>
      {
        cartographerName && (
          <p class="detail-author">
            {cartographer ? (
              <a href={`/cartographers/${cartographer.id}/`}>{cartographerName}</a>
            ) : (
              cartographerName
            )}
          </p>
        )
      }
      {map.blurb && <p class="lede">{map.blurb}</p>}
      <p class="detail-actions">
        <a class="btn" href={`/atlas/#${map.id}`}>View on the atlas →</a>
        {
          /* Omitted while the source essay is held by the staged release gate
             (KAN-263) - the map keeps its catalogue entry either way. */
          sourceEssayTitle && (
            <a class="btn btn--ghost" href={`/essays/${map.essaySlug}/`}>
              {sourceEssayTitle}
            </a>
          )
        }
      </p>
    </header>

    {
      cover && tileSource ? (
        <DeepZoomViewer
          tileSource={tileSource}
          src={cover.src}
          alt={cover.alt}
          credit={cover.credit}
          license={cover.license}
        />
      ) : cover ? (
        <figure class="detail-figure">
          <img src={cover.src} alt={cover.alt} loading="lazy" decoding="async" />
          {cover.credit && (
            <figcaption>
              {cover.credit}
              {cover.license && <span class="lic"> · {cover.license}</span>}
            </figcaption>
          )}
        </figure>
      ) : null
    }

    {
      (rows.length > 0 || cartographerName) && (
        <section class="detail-block">
          <h2>Catalogue record</h2>
          <table class="meta">
            <tbody>
              {cartographerName && (
                <tr>
                  <th scope="row">Cartographer</th>
                  <td>
                    {cartographer ? (
                      <a href={`/cartographers/${cartographer.id}/`}>{cartographerName}</a>
                    ) : (
                      cartographerName
                    )}
                  </td>
                </tr>
              )}
              {rows.map(([label, value]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{value}</td>
                </tr>
              ))}
              {map.sourceUrl && (
                <tr>
                  <th scope="row">Source record</th>
                  <td>
                    <a href={map.sourceUrl}>Open the institutional record →</a>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </section>
      )
    }

    {
      observation && observedRows.length > 0 && (
        <section class="card">
          <h2>Observed</h2>
          <p class="observed-basis">
            Examined by {observation.observedBy} on {observation.observedOn}, from{' '}
            {OBSERVATION_BASIS[observation.basis] ?? observation.basis}. These are notes on this
            copy, not statements about the edition.
          </p>
          <table>
            <tbody>
              {observedRows.map(([label, value]) => (
                <tr>
                  <th scope="row">{label}</th>
                  <td>{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>
      )
    }

    {
      map.uncertainties.length > 0 && (
        <section class="card">
          <h2>Open questions</h2>
          <p class="observed-basis">
            Looked at and unresolved. Listed so the gap reads as a question somebody asked rather
            than a field nobody reached.
          </p>
          <dl class="uncertainties">
            {map.uncertainties.map((item) => (
              <>
                <dt>{item.field}</dt>
                <dd>
                  {item.question} <span class="would-resolve">{item.wouldResolve}</span>
                </dd>
              </>
            ))}
          </dl>
        </section>
      )
    }

    {
      map.tags.length > 0 && (
        <section class="detail-block">
          <h2>Tags</h2>
          <ul class="taglist">
            {map.tags.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatedEssaySlugs.length > 0 && (
        <section class="detail-block">
          <h2>Related essays</h2>
          <ul class="linklist">
            {relatedEssaySlugs.map((slug) => (
              <li>
                <a href={`/essays/${slug}/`}>{essayMeta[slug].title}</a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      relatedMaps.length > 0 && (
        <section class="detail-block">
          <h2>Related maps</h2>
          <ul class="linklist">
            {relatedMaps.map((m) => (
              <li>
                <a href={`/collection/${m.id}/`}>{m.title}</a>
                <span class="muted"> · {formatYear(m.year)}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      bibliography.length > 0 && (
        <section class="detail-block">
          <h2>Bibliography</h2>
          <ul class="biblist">
            {bibliography.map((b) => (
              <li>{b.url ? <a href={b.url}>{b.citation}</a> : b.citation}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="detail-block">
      <h2>Cite this map</h2>
      <CiteExport input={citeInput} />
    </section>
  </article>
</PortalLayout>

<style>
  /* Observation and open questions (KAN-391). Deliberately quieter than the
     metadata table: they are notes on one copy, not the record of the edition. */
  .observed-basis {
    color: var(--ink-muted);
    font-size: var(--step--1);
    margin: 0 0 0.75rem;
  }
  .uncertainties dt {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    text-transform: capitalize;
    color: var(--ink-muted);
  }
  .uncertainties dd {
    margin: 0 0 0.75rem;
  }
  .would-resolve {
    display: block;
    color: var(--ink-muted);
    font-size: var(--step--1);
  }

  .detail {
    padding-block: clamp(2.5rem, 6vw, 4rem);
    max-width: var(--prose-max);
  }
  .crumbs {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .detail-head h1 {
    font-size: var(--step-4);
    margin: 0.3rem 0 0.4rem;
  }
  .detail-author {
    color: var(--accent);
    font-style: italic;
    font-size: var(--step-1);
    margin: 0 0 0.75rem;
  }
  .lede {
    color: var(--ink-muted);
    font-size: var(--step-1);
    margin: 0 0 1.5rem;
  }
  .detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0 0 2.5rem;
  }
  .btn {
    display: inline-block;
    padding: 0.55rem 1rem;
    border-radius: var(--radius);
    border: 1px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
  }
  .btn:hover {
    background: color-mix(in srgb, var(--accent) 28%, transparent);
    color: var(--ink);
  }
  .btn--ghost {
    background: transparent;
    border-color: var(--line);
    color: var(--ink-muted);
  }
  .btn--ghost:hover {
    border-color: var(--accent);
    color: var(--ink);
  }

  .detail-figure {
    margin: 0 0 2.5rem;
  }
  .detail-figure img {
    width: 100%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: block;
  }
  .detail-figure figcaption {
    font-size: var(--step--1);
    color: var(--ink-muted);
    margin-top: 0.5rem;
  }
  .detail-figure .lic {
    color: var(--ink-muted);
  }

  .detail-block {
    margin-bottom: 2.5rem;
  }
  .detail-block h2 {
    font-size: var(--step-1);
    margin: 0 0 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--line);
  }
  .meta {
    width: 100%;
    border-collapse: collapse;
  }
  .meta th,
  .meta td {
    text-align: left;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
    font-size: var(--step-0);
  }
  .meta th {
    width: 32%;
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-weight: 400;
  }
  .linklist,
  .biblist {
    margin: 0;
    padding-left: 1.2rem;
  }
  .linklist li,
  .biblist li {
    margin-bottom: 0.5rem;
    color: var(--ink-muted);
  }
  .linklist a,
  .biblist a {
    color: var(--accent);
  }
  .linklist a:hover,
  .biblist a:hover {
    color: var(--ink);
  }
  .muted {
    color: var(--ink-muted);
  }
  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .taglist li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.2rem 0.6rem;
  }
</style>
