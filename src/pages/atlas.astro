---
import PortalLayout from '../layouts/PortalLayout.astro';
import AtlasMap from '../components/islands/AtlasMap.astro';
import MetaLensExplorer from '../components/MetaLensExplorer.astro';
import DatasetCitations from '../components/DatasetCitations.astro';
import { getEssays, formatYear } from '../lib/registry';

const essays = await getEssays();

// Shared, ancient-compressed time scale (seed for E5/EG; MapLibre map view lands
// in ATLAS-502). Square-root compression gives recent centuries more room.
const NOW = 2024;
const OLDEST = Math.min(...essays.map((e) => e.data.yearFrom));
const ageMax = NOW - OLDEST;
const pos = (year: number) => (1 - Math.sqrt((NOW - year) / ageMax)) * 100;

const ticks = [OLDEST, -600, 150, 1150, 1500, 1750, NOW];
const bars = essays.map((e) => {
  const x1 = pos(e.data.yearFrom);
  const x2 = pos(e.data.yearTo);
  return { essay: e, left: x1, width: Math.max(x2 - x1, 1.5) };
});
---

<PortalLayout
  title="Atlas"
  description="A cross-essay meta-layer: every essay plotted on one shared, ancient-compressed timeline of cartographic history."
>
  <section class="shell atlas">
    <header class="atlas-head">
      <p class="eyebrow">The atlas · meta-layer</p>
      <h1>Every essay, in space and time</h1>
      <p class="lede">
        A cross-essay meta-layer: the whole corpus of maps plotted on one interactive map, and every
        essay charted on one shared timeline (ancient centuries compressed).
      </p>
      <p class="lede">
        Alongside the corpus you can draw reconstructed territories, routes, frontiers, places and
        historical networks. Every layer answers the timeline, and every layer carries notes
        explaining its sources, how it was interpreted and how much of it was reconstructed. Those
        notes live in the <a href="/atlas/handbook/">Atlas Handbook</a>.
      </p>
      <aside class="handbook-callout" aria-labelledby="handbook-callout-title">
        <div>
          <h2 id="handbook-callout-title">New to the Atlas?</h2>
          <p>
            Learn how to read layers, chronology, evidence, reconstruction, uncertainty, provenance
            and sources before you explore.
          </p>
        </div>
        <a href="/atlas/handbook/">Read the Handbook →</a>
      </aside>
    </header>

    <h2 class="section-h">The corpus, mapped</h2>
    <p class="section-lede">
      Every historical map discussed across the essays, geolocated. Drag the slider to reveal them
      in chronological order; search or filter by essay.
    </p>
    <AtlasMap />

    <DatasetCitations />

    <MetaLensExplorer essays={essays} />

    <h2 class="section-h section-h--spaced">One timeline, every essay</h2>
    <div class="timeline" role="group" aria-label="Timeline of essays across cartographic history">
      <div class="axis" aria-hidden="true">
        {
          ticks.map((t) => (
            <span class="tick" style={`left:${pos(t)}%`}>
              <span class="tick-label">{formatYear(t)}</span>
            </span>
          ))
        }
      </div>
      <div class="tracks">
        {
          bars.map(({ essay, left, width }) => (
            <a
              class="track"
              href={`/essays/${essay.slug}/`}
              data-atlas-track
              data-essay={essay.slug}
              data-year-from={essay.data.yearFrom}
              data-year-to={essay.data.yearTo}
              aria-current="false"
              style={`left:${left}%; width:${width}%; --accent:${essay.data.accent ?? 'var(--gold)'}`}
              title={`${essay.data.title} (${formatYear(essay.data.yearFrom)} – ${formatYear(essay.data.yearTo)})`}
            >
              <span class="track-label" transition:name={`essay-${essay.slug}`}>
                {essay.data.title}
              </span>
            </a>
          ))
        }
      </div>
    </div>

    <p class="note">
      Note: the scale is deliberately non-linear - a critical atlas measures time the way its maps
      measured space, with its own compressions and silences.
    </p>
  </section>
</PortalLayout>

<script>
  const bindAtlasTimeline = () => {
    const tracks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-atlas-track]'));
    if (!tracks.length) return;

    const select = (slug = '') => {
      for (const track of tracks) {
        const selected = track.dataset.essay === slug;
        track.classList.toggle('is-selected', selected);
        track.setAttribute('aria-current', selected ? 'true' : 'false');
      }
    };
    const reveal = (year: number) => {
      for (const track of tracks) {
        const visible = Number(track.dataset.yearFrom) <= year;
        track.classList.toggle('is-future', !visible);
        track.dataset.revealed = String(visible);
      }
    };
    const onSelection = ((event: Event) => {
      select((event as CustomEvent<{ essaySlug?: string }>).detail?.essaySlug ?? '');
    }) as EventListener;
    const onTime = ((event: Event) => {
      reveal((event as CustomEvent<{ year?: number }>).detail?.year ?? 2024);
    }) as EventListener;

    const atlasWindow = window as unknown as {
      __atlasTimelineSelection?: EventListener;
      __atlasTimelineTime?: EventListener;
    };
    if (atlasWindow.__atlasTimelineSelection) {
      document.removeEventListener('atlas:selection', atlasWindow.__atlasTimelineSelection);
    }
    if (atlasWindow.__atlasTimelineTime) {
      document.removeEventListener('atlas:time', atlasWindow.__atlasTimelineTime);
    }
    atlasWindow.__atlasTimelineSelection = onSelection;
    atlasWindow.__atlasTimelineTime = onTime;
    document.addEventListener('atlas:selection', onSelection);
    document.addEventListener('atlas:time', onTime);

    for (const track of tracks) {
      const send = () => {
        document.dispatchEvent(
          new CustomEvent('atlas:essay', { detail: { slug: track.dataset.essay } }),
        );
      };
      track.addEventListener('focus', send);
      track.addEventListener('pointerenter', send);
    }

    const params = new URLSearchParams(location.search);
    select(params.get('essay') ?? '');
    reveal(Number(params.get('year') ?? 2024));
  };

  bindAtlasTimeline();
  document.addEventListener('astro:page-load', bindAtlasTimeline);
</script>

<style>
  .atlas {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }
  .atlas-head {
    margin-bottom: 2.5rem;
  }
  .atlas-head h1 {
    font-size: var(--step-4);
    margin: 0.3rem 0 0.75rem;
  }
  .lede {
    color: var(--ink-muted);
    font-size: var(--step-1);
    margin: 0;
  }
  .handbook-callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding: 1rem 1.15rem;
    border: 1px solid var(--line);
    border-left: 3px solid var(--gold);
    border-radius: var(--radius);
    background: var(--panel);
  }
  .handbook-callout h2 {
    margin: 0 0 0.25rem;
    font-size: var(--step-1);
  }
  .handbook-callout p {
    margin: 0;
    color: var(--ink-muted);
  }
  .handbook-callout a {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }
  @media (max-width: 640px) {
    .handbook-callout {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  .section-h {
    font-size: var(--step-2);
    margin: 0 0 0.5rem;
  }
  .section-h--spaced {
    margin-top: 3.5rem;
  }
  .section-lede {
    color: var(--ink-muted);
    margin: 0 0 1.25rem;
    max-width: var(--prose-max);
  }
  .timeline {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--panel);
    padding: 3.25rem 1.5rem 1.5rem;
    overflow: hidden;
  }
  .axis {
    position: relative;
    height: 0;
  }
  .tick {
    position: absolute;
    top: -2.5rem;
    transform: translateX(-50%);
    border-left: 1px dashed var(--line);
    height: calc(100% + 8rem);
    padding-top: 0;
  }
  .tick-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    color: var(--ink-muted);
    position: absolute;
    top: -1.1rem;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .tracks {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .track {
    position: relative;
    height: 2.4rem;
    min-width: 2.4rem;
    background: color-mix(in srgb, var(--accent) 22%, var(--panel-2));
    border: 1px solid color-mix(in srgb, var(--accent) 55%, var(--line));
    border-radius: 999px;
    display: flex;
    align-items: center;
    padding-inline: 0.9rem;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .track:hover {
    background: color-mix(in srgb, var(--accent) 40%, var(--panel-2));
  }
  .track.is-selected {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    background: color-mix(in srgb, var(--accent) 48%, var(--panel-2));
  }
  .track.is-future {
    opacity: 0.34;
  }
  .track-label {
    font-family: var(--font-display);
    font-size: var(--step-0);
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .note {
    color: var(--ink-muted);
    font-style: italic;
    margin-top: 1.5rem;
    max-width: var(--prose-max);
  }
</style>
