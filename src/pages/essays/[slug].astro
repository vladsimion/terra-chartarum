---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getEssays } from '../../lib/registry';
import RoomBadge from '../../components/RoomBadge.astro';
import RoomPath from '../../components/RoomPath.astro';
import RelatedByRoom from '../../components/RelatedByRoom.astro';
import EssayHero from '../../components/EssayHero.astro';
import MetaLens from '../../components/MetaLens.astro';
import CiteExport from '../../components/islands/CiteExport.astro';
import { getRoomPath, getRelatedByRoom } from '../../lib/room-content';
import type { CiteInput } from '../../lib/cite';
import { articleSchema, breadcrumbSchema } from '../../lib/structured-data';

export async function getStaticPaths() {
  const essays = await getEssays();
  return essays.map((essay, i) => ({
    params: { slug: essay.slug },
    props: {
      essay,
      prev: essays[(i - 1 + essays.length) % essays.length],
      next: essays[(i + 1) % essays.length],
    },
  }));
}

const { essay, prev, next } = Astro.props;
const { data } = essay;
const accent = data.accent ?? 'var(--gold)';

// ATLAS-301 decision: legacy essays are full self-contained HTML documents
// (own <head>, fonts, global body styles), so the isolation boundary is an
// <iframe> sourced from public/embed/<slug>/. This guarantees zero style/JS
// leakage against the portal chrome. Native (MDX) essays render inline instead.
const isLegacy = data.status === 'legacy' && data.embedPath;
const { Content } = await essay.render();

// Room cross-linking (KAN-99): place this essay within its room's reading path
// and surface a mixed grid of other room content at the essay's end.
const roomPath = await getRoomPath(data.room, essay.slug);
const relatedByRoom = await getRelatedByRoom(data.room, { excludeEssaySlug: essay.slug });
const citeInput: CiteInput = {
  id: essay.slug,
  kind: 'essay',
  title: data.title,
  author: 'Terra Chartarum',
  year: Number(data.publishedAt.slice(0, 4)),
  publisher: 'Terra Chartarum',
  containerTitle: 'Terra Chartarum',
  url: new URL(`/essays/${essay.slug}/`, Astro.site).toString(),
};

// Every essay page keeps two bars pinned at the top: the site header and the
// essay bar below it. Their combined height is measured here and published as
// --essay-chrome-h, which offsets in-essay anchors (Section.astro) and sizes the
// legacy embed frame. Injected verbatim via set:html so it ships as inline JS
// rather than a bundled module.
//
// On a legacy essay the script does two more things. Section deep-links (KAN-95):
// a room page links to /essays/<slug>/#<id>, and the essay lives in a same-origin
// iframe, so the parent hash is forwarded into the frame's src to scroll the embed
// to that chapter. And an embed's own internal anchors scroll the frame's
// document, after which the browser aligns the frame's top with the viewport top
// - straight under our pinned bars. The embed cannot measure them, so the same
// height goes in as --portal-chrome for the embed to add to its
// scroll-margin-top. Embeds that do not read it are unaffected, and an embed
// opened outside the portal falls back to its standalone offset.
//
// No embed currently reads --portal-chrome: dacia was the only one, and it is a
// native essay as of the Terra Sigillata migration. The plumbing is kept because
// it is generic and the next legacy embed with internal cross-links needs it; the
// e2e case that covered it went with dacia's iframe, since no other embed has the
// cross-links to exercise it.
const essayChromeScript = `(function () {
  function frameEl() {
    return document.getElementById('essay-frame');
  }
  function syncHash() {
    var frame = frameEl();
    if (!frame) return;
    var base = frame.getAttribute('data-base');
    var hash = window.location.hash;
    if (!base || !hash) return;
    var want = base + hash;
    if (frame.getAttribute('src') !== want) frame.setAttribute('src', want);
  }
  function chromeHeight() {
    // Everything pinned above the frame: the site header, then the essay bar
    // sitting below it. Measured rather than assumed, because the header grows a
    // row when the nav wraps (KAN-65).
    var stack = ['.site-header', '.essay-bar'];
    var total = 0;
    for (var i = 0; i < stack.length; i++) {
      var el = document.querySelector(stack[i]);
      if (el) total += el.offsetHeight;
    }
    return total;
  }
  function syncChrome() {
    var px = chromeHeight() + 'px';
    // Sizes the frame to the space it can actually occupy...
    document.documentElement.style.setProperty('--essay-chrome-h', px);
    var frame = frameEl();
    if (!frame) return;
    var doc;
    try {
      doc = frame.contentDocument;
    } catch (e) {
      return;
    }
    if (!doc || !doc.documentElement) return;
    // ...and tells the embed how much of its own top is covered.
    doc.documentElement.style.setProperty('--portal-chrome', px);
  }
  function bindFrame() {
    var frame = frameEl();
    if (!frame || frame.dataset.chromeBound) return;
    frame.dataset.chromeBound = '1';
    // The frame is loading="lazy", so on the first pass its document may not
    // exist yet and there is nothing to push --portal-chrome into. The load event
    // covers that, and fires again after syncHash rewrites src.
    frame.addEventListener('load', syncChrome);
  }
  var chromeObserver;
  function observeChrome() {
    if (typeof ResizeObserver === 'undefined') return;
    // Catches the nav wrapping, a font swap reflowing the header, and plain
    // viewport resizes, since both bars are full-width.
    if (chromeObserver) chromeObserver.disconnect();
    chromeObserver = new ResizeObserver(syncChrome);
    var header = document.querySelector('.site-header');
    var bar = document.querySelector('.essay-bar');
    if (header) chromeObserver.observe(header);
    if (bar) chromeObserver.observe(bar);
  }
  function sync() {
    bindFrame();
    observeChrome();
    syncHash();
    syncChrome();
  }
  sync();
  window.addEventListener('hashchange', syncHash);
  document.addEventListener('astro:page-load', sync);
})();`;
---

<PortalLayout
  title={data.title}
  description={data.summary}
  ogImage={`/og/${essay.slug}.png`}
  ogImageAlt={`${data.title} - ${data.subtitle}`}
  ogType="article"
  publishedAt={data.publishedAt}
  updatedAt={data.updatedAt}
  schema={[
    articleSchema(essay, Astro.site!),
    breadcrumbSchema(
      [
        { name: 'Essays', path: '/essays/' },
        { name: data.title, path: `/essays/${essay.slug}/` },
      ],
      Astro.site!,
    ),
  ]}
>
  <div class="essay-bar" style={`--accent:${accent}`}>
    <div class="shell bar-inner">
      <a class="back" href="/essays/">← Atlas of essays</a>
      <span class="crumb" aria-hidden="true">/</span>
      <span class="crumb-title" transition:name={`essay-${essay.slug}`}>{data.title}</span>
      <RoomBadge room={data.room} variant="solid" />
      <nav class="pager" aria-label="Essay navigation">
        <a href={`/essays/${prev.slug}/`} title={prev.data.title}>‹ Prev</a>
        <a href={`/essays/${next.slug}/`} title={next.data.title}>Next ›</a>
      </nav>
    </div>
  </div>

  {
    isLegacy ? (
      <>
        {/*
         * A legacy essay's text lives inside the isolation iframe, so its hero
         * has to sit in the portal chrome above the frame. It spans the shell
         * rather than the prose measure, matching the full-bleed embed below it.
         */}
        {data.hero && (
          <div class="shell legacy-hero">
            <EssayHero src={data.hero} />
          </div>
        )}
        <iframe
          id="essay-frame"
          class="essay-frame"
          src={data.embedPath}
          data-base={data.embedPath}
          title={`${data.title} - ${data.subtitle}`}
          loading="lazy"
        />
      </>
    ) : (
      <article class="shell native-essay">
        {data.hero && <EssayHero src={data.hero} />}
        <Content />
        <MetaLens
          slug={essay.slug}
          title={data.title}
          lenses={data.lenses}
          scores={data.metaScores}
        />
      </article>
    )
  }

  <section class="shell essay-citation" aria-labelledby="essay-citation-title">
    <h2 id="essay-citation-title">Cite this essay</h2>
    <CiteExport input={citeInput} />
  </section>

  {
    (roomPath || relatedByRoom.length > 0) && (
      <div class="shell essay-room-links">
        {roomPath && <RoomPath path={roomPath} />}
        <RelatedByRoom room={data.room} items={relatedByRoom} />
      </div>
    )
  }

  <script is:inline set:html={essayChromeScript} />
</PortalLayout>

<style>
  .essay-bar {
    position: sticky;
    /*
     * Pin below the site header, not on top of it. Both are sticky, so at top:0
     * the header (z-index 50) painted straight over this bar and its back link,
     * crumb, room badge and pager were unreachable on every scrolled essay page.
     * --header-h is measured at runtime by PortalLayout because the primary nav
     * wraps into a second row on narrow viewports (KAN-65).
     */
    top: var(--header-h, 4.5rem);
    z-index: 40;
    background: color-mix(in srgb, var(--canvas) 92%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
    border-top: 1px solid transparent;
  }
  .bar-inner {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    /*
     * Wrap rather than overflow (KAN-432). The back link, room badge and pager
     * are all `white-space: nowrap` and together they are wider than a phone,
     * so with `nowrap` the pager was pushed off the right edge and every essay
     * page scrolled sideways - a reflow failure on published essays, not only
     * on the held one. Wrapping puts the pager on a second row instead, and
     * --essay-chrome-h is measured at runtime, so the sticky offset follows.
     */
    flex-wrap: wrap;
    row-gap: 0.35rem;
    padding-block: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.06em;
  }
  .back {
    color: var(--accent);
    white-space: nowrap;
  }
  .crumb {
    color: var(--ink-muted);
  }
  .crumb-title {
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    /*
     * The ellipsis above never fired. A flex item's default `min-width: auto`
     * refuses to shrink below its content, so a long title pushed the pager
     * past the right edge and every essay page scrolled sideways on a phone -
     * 42 to 65px depending on the title. `min-width: 0` lets the title give way,
     * which is what it was always styled to do. Found by the KAN-432 mobile
     * pass; it affected published essays too, not only Antarctica.
     */
    min-width: 0;
  }
  .pager {
    margin-left: auto;
    display: flex;
    gap: 1rem;
    white-space: nowrap;
  }
  .pager a {
    color: var(--ink-muted);
  }
  .pager a:hover {
    color: var(--ink);
  }

  .essay-frame {
    display: block;
    width: 100%;
    /*
     * Fill the viewport below everything pinned above it; the essay scrolls
     * inside. --essay-chrome-h is the measured height of the site header plus
     * the essay bar, published by the inline script above.
     */
    height: calc(100dvh - var(--essay-chrome-h));
    border: 0;
    background: var(--canvas);
  }
  .native-essay {
    padding-block: 3rem;
    /*
     * Cap the ch-based measure with a font-independent width. Without the cap,
     * the fallback font makes this container about 60px wider before the
     * self-hosted body face arrives, producing a visible layout shift.
     */
    max-width: min(var(--prose-max, 44rem), 44rem);
  }
  /*
   * In-essay heading anchors, the targets of an essay's own deep links (dacia's
   * core column into its strata, its timeline into the stelae). Section.astro
   * already does this for chapter anchors; a bare heading inside a chapter needs
   * it too, or the jump parks it behind the pinned header and essay bar.
   *
   * --in-essay-sticky-h is whatever the essay itself pins over a stretch of its
   * own body, on top of the page chrome - dacia's squeeze bar over the
   * lapidarium. The component that pins it measures itself and sets the
   * property on its wrapper, so it applies to the headings inside that stretch
   * and nowhere else.
   */
  .native-essay :global(:is(h3, h4)[id]) {
    scroll-margin-top: calc(var(--essay-chrome-h) + var(--in-essay-sticky-h, 0px) + 1rem);
  }
  .legacy-hero {
    padding-block: 2.5rem 0;
  }
  .essay-room-links {
    padding-block: 1rem 4rem;
    max-width: min(var(--prose-max, 44rem), 44rem);
  }
  .essay-citation {
    max-width: min(var(--prose-max, 44rem), 44rem);
    padding-block: 2rem 1rem;
  }
  .essay-citation h2 {
    margin: 0 0 0.8rem;
    font-size: var(--step-2);
  }
</style>
