{
  "schemaVersion": 1,
  "contract": "data/contracts/terra-chartarum.json",
  "registries": [
    {
      "name": "essays",
      "authority": "atlas",
      "family": "essay",
      "idField": "slug",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "content-files",
        "path": "src/content/essays",
        "extensions": [".md", ".mdx"]
      }
    },
    {
      "name": "maps",
      "authority": "atlas",
      "family": "map",
      "idField": "id",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "typescript-array",
        "path": "src/lib/corpus.ts",
        "variable": "RAW"
      }
    },
    {
      "name": "cartographers",
      "authority": "atlas",
      "family": "cartographer",
      "idField": "id",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "typescript-array",
        "path": "src/lib/cartographers.ts",
        "variable": "RAW"
      }
    },
    {
      "name": "bibliography",
      "authority": "atlas",
      "family": "source",
      "idField": "id",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "typescript-array",
        "path": "src/lib/bibliography.ts",
        "variable": "RAW"
      }
    },
    {
      "name": "toponyms",
      "authority": "atlas",
      "family": "place",
      "idField": "id",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "typescript-array",
        "path": "src/lib/toponyms.ts",
        "variable": "RAW"
      }
    },
    {
      "name": "layers",
      "authority": "atlas",
      "family": "layer",
      "idField": "id",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "typescript-array",
        "path": "src/lib/geo.ts",
        "variable": "RAW"
      }
    },
    {
      "name": "collections",
      "authority": "atlas",
      "family": "collection",
      "idField": "id",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "typescript-array",
        "path": "src/lib/geo-collections.ts",
        "variable": "RAW"
      }
    },
    {
      "name": "geo-release-assets",
      "authority": "atlas",
      "family": "dataset",
      "idField": "id",
      "idPattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "json-array",
        "path": "data/geo/catalog.json",
        "property": "assets"
      }
    },
    {
      "name": "vmn-ports",
      "authority": "vmn",
      "family": "port",
      "idField": "port_id",
      "coalesceIds": true,
      "source": {
        "format": "csv",
        "path": "data/vmn/ports.csv"
      }
    },
    {
      "name": "vmn-waypoints",
      "authority": "vmn",
      "family": "place",
      "idField": "waypoint_id",
      "source": {
        "format": "csv",
        "path": "data/vmn/waypoints.csv"
      }
    },
    {
      "name": "vmn-routes",
      "authority": "vmn",
      "family": "route",
      "idField": "route_id",
      "source": {
        "format": "csv",
        "path": "data/vmn/routes.csv"
      }
    },
    {
      "name": "vmn-territories",
      "authority": "vmn",
      "family": "period",
      "idField": "territory",
      "coalesceIds": true,
      "source": {
        "format": "csv",
        "path": "data/vmn/events.csv"
      }
    },
    {
      "name": "vmn-sources",
      "authority": "vmn",
      "family": "source",
      "idField": "key",
      "source": {
        "format": "csv",
        "path": "data/vmn/sources.csv"
      }
    },
    {
      "name": "vmn-commodities",
      "authority": "vmn",
      "family": "dataset",
      "idField": "commodity_id",
      "source": {
        "format": "csv",
        "path": "data/vmn/commodities.csv"
      }
    },
    {
      "name": "vmn-atlas-links",
      "authority": "vmn",
      "family": "event",
      "idField": "beat_id",
      "source": {
        "format": "csv",
        "path": "data/vmn/atlas_links.csv"
      }
    },
    {
      "name": "cnd-places",
      "authority": "cnd",
      "family": "place",
      "idField": "place_id",
      "idPattern": "^plc-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "csv",
        "path": "data/dacia/places.csv"
      }
    },
    {
      "name": "cnd-sources",
      "authority": "cnd",
      "family": "source",
      "idField": "source_id",
      "idPattern": "^src-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "csv",
        "path": "data/dacia/sources.csv"
      }
    },
    {
      "name": "cnd-attestations",
      "authority": "cnd",
      "family": "event",
      "idField": "attestation_id",
      "idPattern": "^att-[0-9]{4,}$",
      "source": {
        "format": "csv",
        "path": "data/dacia/attestations.csv"
      }
    },
    {
      "name": "cnd-name-uses",
      "authority": "cnd",
      "family": "dataset",
      "idField": "name_use_id",
      "idPattern": "^nmu-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "csv",
        "path": "data/dacia/name-uses.csv",
        "optional": true
      }
    },
    {
      "name": "cnd-name-use-edges",
      "authority": "cnd",
      "family": "dataset",
      "idField": "edge_id",
      "idPattern": "^nue-[a-z0-9]+(?:-[a-z0-9]+)*$",
      "source": {
        "format": "csv",
        "path": "data/dacia/name-use-edges.csv",
        "optional": true
      }
    },
    {
      "name": "ccd-projects",
      "authority": "ccd",
      "family": "project",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/dacia/reference/programme-ids.csv"
      }
    },
    {
      "name": "hse-places",
      "authority": "hse",
      "family": "place",
      "idField": "place_id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/places.csv"
      }
    },
    {
      "name": "hse-place-phases",
      "authority": "hse",
      "family": "period",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/places.csv"
      }
    },
    {
      "name": "hse-routes",
      "authority": "hse",
      "family": "route",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/routes.csv"
      }
    },
    {
      "name": "hse-events",
      "authority": "hse",
      "family": "event",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/events.csv"
      }
    },
    {
      "name": "hse-sources",
      "authority": "hse",
      "family": "source",
      "idField": "key",
      "reportOrphans": true,
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/sources.csv"
      }
    },
    {
      "name": "hse-commodities",
      "authority": "hse",
      "family": "dataset",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/commodities.csv"
      }
    },
    {
      "name": "hse-route-commodities",
      "authority": "hse",
      "family": "dataset",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/route_commodities.csv"
      }
    },
    {
      "name": "hse-kontore",
      "authority": "hse",
      "family": "dataset",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/kontore.csv"
      }
    },
    {
      "name": "hse-corpus",
      "authority": "hse",
      "family": "map",
      "idField": "key",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/corpus.csv"
      }
    },
    {
      "name": "hse-evidence",
      "authority": "hse",
      "family": "dataset",
      "idField": "claim_id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/evidence.csv"
      }
    },
    {
      "name": "hse-chronology",
      "authority": "hse",
      "family": "period",
      "idField": "id",
      "source": {
        "format": "csv",
        "path": "data/hanseatic/sources/chronology.csv"
      }
    }
  ],
  "relations": [
    {
      "from": "maps",
      "field": "essaySlug",
      "to": ["essays"],
      "required": true
    },
    {
      "from": "maps",
      "field": "cartographerId",
      "to": ["cartographers"]
    },
    {
      "from": "maps",
      "field": "bibliography",
      "to": ["bibliography"]
    },
    {
      "from": "maps",
      "field": "relatedMapIds",
      "to": ["maps"]
    },
    {
      "from": "maps",
      "field": "relatedEssaySlugs",
      "to": ["essays"]
    },
    {
      "from": "cartographers",
      "field": "essaySlugs",
      "to": ["essays"]
    },
    {
      "from": "toponyms",
      "field": "mapIds",
      "to": ["maps"]
    },
    {
      "from": "toponyms",
      "field": "essaySlugs",
      "to": ["essays"]
    },
    {
      "from": "layers",
      "field": "essaySlugs",
      "to": ["essays"]
    },
    {
      "from": "layers",
      "field": "essayLinks[].slug",
      "to": ["essays"]
    },
    {
      "from": "geo-release-assets",
      "field": "id",
      "to": ["layers"],
      "required": true
    },
    {
      "from": "vmn-ports",
      "field": "source_keys",
      "to": ["vmn-sources"],
      "split": "[|;]",
      "transform": "before-colon"
    },
    {
      "from": "vmn-waypoints",
      "field": "source_keys",
      "to": ["vmn-sources"],
      "split": "[|;]",
      "transform": "before-colon"
    },
    {
      "from": "vmn-routes",
      "field": "source_keys",
      "to": ["vmn-sources"],
      "split": "[|;]",
      "transform": "before-colon"
    },
    {
      "from": "vmn-routes",
      "field": "waypoints",
      "to": ["vmn-ports", "vmn-waypoints"],
      "split": "\\|",
      "required": true
    },
    {
      "from": "vmn-routes",
      "field": "commodities",
      "to": ["vmn-commodities"],
      "split": "\\|",
      "required": true
    },
    {
      "from": "vmn-territories",
      "field": "source_keys",
      "to": ["vmn-sources"],
      "split": "[|;]",
      "transform": "before-colon"
    },
    {
      "from": "vmn-commodities",
      "field": "source_keys",
      "to": ["vmn-sources"],
      "split": "[|;]",
      "transform": "before-colon"
    },
    {
      "from": "vmn-atlas-links",
      "field": "target_id",
      "to": ["vmn-routes"],
      "required": true,
      "when": {
        "field": "target_type",
        "equals": "route"
      }
    },
    {
      "from": "vmn-atlas-links",
      "field": "target_id",
      "to": ["vmn-ports"],
      "required": true,
      "when": {
        "field": "target_type",
        "equals": "port"
      }
    },
    {
      "from": "vmn-atlas-links",
      "field": "target_id",
      "to": ["vmn-territories"],
      "required": true,
      "when": {
        "field": "target_type",
        "equals": "territory"
      }
    },
    {
      "from": "vmn-atlas-links",
      "field": "layer_ids",
      "to": ["layers"],
      "split": "\\|",
      "required": true
    },
    {
      "from": "cnd-attestations",
      "field": "place_id",
      "to": ["cnd-places"],
      "required": true
    },
    {
      "from": "cnd-attestations",
      "field": "source_id",
      "to": ["cnd-sources"],
      "required": true
    },
    {
      "from": "cnd-name-uses",
      "field": "source_id",
      "to": ["cnd-sources"]
    },
    {
      "from": "cnd-name-uses",
      "field": "referent_place_id",
      "to": ["cnd-places"]
    },
    {
      "from": "cnd-name-use-edges",
      "field": "from_name_use",
      "to": ["cnd-name-uses"],
      "required": true
    },
    {
      "from": "cnd-name-use-edges",
      "field": "to_name_use",
      "to": ["cnd-name-uses"],
      "required": true
    },
    {
      "from": "cnd-name-use-edges",
      "field": "evidence_attestation_id",
      "to": ["cnd-attestations"]
    },
    {
      "from": "hse-place-phases",
      "field": "place_id",
      "to": ["hse-places"],
      "required": true
    },
    {
      "from": "hse-place-phases",
      "field": "source",
      "to": ["hse-sources"],
      "required": true
    },
    {
      "from": "hse-routes",
      "field": "from_place_id",
      "to": ["hse-places"],
      "required": true
    },
    {
      "from": "hse-routes",
      "field": "to_place_id",
      "to": ["hse-places"],
      "required": true
    },
    {
      "from": "hse-routes",
      "field": "waypoints",
      "to": ["hse-places"],
      "split": "\\|",
      "required": true
    },
    {
      "from": "hse-routes",
      "field": "commodities",
      "to": ["hse-commodities"],
      "split": "\\|",
      "required": true
    },
    {
      "from": "hse-routes",
      "field": "source",
      "to": ["hse-sources"],
      "required": true
    },
    {
      "from": "hse-events",
      "field": "place_id",
      "to": ["hse-places"],
      "required": true
    },
    {
      "from": "hse-events",
      "field": "source",
      "to": ["hse-sources"],
      "required": true
    },
    {
      "from": "hse-commodities",
      "field": "source",
      "to": ["hse-sources"],
      "required": true
    },
    {
      "from": "hse-route-commodities",
      "field": "route_id",
      "to": ["hse-routes"],
      "required": true
    },
    {
      "from": "hse-route-commodities",
      "field": "commodity_id",
      "to": ["hse-commodities"],
      "required": true
    },
    {
      "from": "hse-route-commodities",
      "field": "source",
      "to": ["hse-sources"],
      "required": true
    },
    {
      "from": "hse-kontore",
      "field": "place_id",
      "to": ["hse-places"],
      "required": true
    },
    {
      "from": "hse-kontore",
      "field": "primary_witness",
      "to": ["hse-corpus"],
      "required": true
    },
    {
      "from": "hse-kontore",
      "field": "source",
      "to": ["hse-sources"],
      "required": true
    },
    {
      "from": "hse-evidence",
      "field": "source_key",
      "to": ["hse-sources"],
      "required": true
    },
    {
      "from": "hse-evidence",
      "field": "feature_id",
      "to": [
        "hse-place-phases",
        "hse-routes",
        "hse-events",
        "hse-commodities",
        "hse-route-commodities",
        "hse-kontore",
        "hse-chronology"
      ],
      "required": true
    },
    {
      "from": "hse-chronology",
      "field": "claim_id",
      "to": ["hse-evidence"],
      "required": true
    },
    {
      "from": "collections",
      "field": "layerIds",
      "to": ["layers"],
      "required": true
    },
    {
      "from": "collections",
      "field": "defaultLayerIds",
      "to": ["layers"]
    },
    {
      "from": "collections",
      "field": "essaySlugs",
      "to": ["essays"]
    }
  ]
}
