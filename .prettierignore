# Build output
dist/
.astro/

# Dependencies
node_modules/

# Legacy essays and embeds are preserved verbatim (KAN-17 / ATLAS-105) - never reformat them.
# One carve-out (KAN-66): house punctuation applies everywhere, so `npm run
# typography:validate` does check these files for em dashes. Nothing else here is
# reformatted.
public/essays/
public/embed/

# prettier-plugin-astro cannot parse TypeScript inside a <script> nested in a JSX
# expression ({interactive && <script>…}); Astro compiles it fine. Skip this one
# file rather than rewrite shipped, working island code.
src/components/islands/RadarChart.astro

# Generated / third-party static assets
public/geo/
public/pagefind/

# `make hanseatic` writes this from Python, whose json.dumps(indent=2) always
# expands arrays while Prettier collapses short ones. Reformatting it here would
# only be undone by the next regeneration.
src/data/hanseatic/generated/

# `make antarctica` writes this from Python, for the same reason.
src/data/antarctica/generated/

# `make crusades` likewise.
src/data/crusades/generated/

# `make dacia` now also emits Campaign III packages alongside its existing
# generated projections; keep every deterministic Python JSON output byte-stable.
src/data/dacia/generated/

# `make dacia` writes the CND release from Python. Its bytes are hashed into the
# release manifest, so reformatting them here would put the committed tree
# permanently at odds with the manifest that describes it.
data/dacia/release/

# `make antarctica` writes the pilot release from Python and hashes its own
# bytes into the manifest; reformatting them here would break that check.
data/antarctica/release/

# `make crusades` writes its pilot release the same way, with the same hazard.
data/crusades/release/

# Lockfiles and data dumps
package-lock.json
*.csv

# Content-authored data left as-authored
*.geojson
